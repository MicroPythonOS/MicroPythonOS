SD_SPI_FREQ = const(500000)
SD_MISO = const(2)
SD_SCLK = const(14)
SD_MOSI = const(15)
SD_CS = const(13)

# Power ADC
ADC_IN = const(35)

# Buzzer
SPEAKER_PWD = const(19)
SPEAKER_OUT = const(25)

