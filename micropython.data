            self.ir = None
        import mpos.ui

        mpos.ui.change_task_handler()

    def _on_ir(self, cmd, addr, ctrl):
        if cmd < 0:
            line = "Decode error."
        else:
            line = f"Cmd 0x{cmd:02x} Addr 0x{addr:04x}"
        print(line)
