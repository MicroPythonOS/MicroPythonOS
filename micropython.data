    def _register_wsen_isds_sensors(self):
        self._sensor_list = [
            Sensor(
                name="WSEN_ISDS Accelerometer",
                sensor_type=TYPE_ACCELEROMETER,
                vendor="WÃ¼rth Elektronik",
                version=1,
