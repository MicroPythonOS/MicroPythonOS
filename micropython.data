ñ<ç,aµÂá*ƒõƒzU¨_(¥«œ³xžR±L´€Î`Êå=[¸ã^2ÙjÕŠ){ø~ªçû6GD¨†3TgÊ(”2Yãœ{µ\Þ³…øýÇ&;0fa{m¦Rºw``h}&—W•™¢­”÷êª6GTúA3X”R.“Ë+c|U*MÝÌÂ˜í-t’Æƒ‘,ì¶cÇ)•¸ÑF!ÕÙlT×¢£•„xlÆóH¥³Ï§Z.}cûÖ·î†»gˆ_÷m ãû–Äš‘¢c/»4“¸BiÎtÖ™ÃR(m´Ç+•jé¡Émïü+±<æÞunnßuÒ@Hçr¹%âû59ª	 P¢Â0*—Ë[€Yâºgé <ôžÍúkñ>±óp´þÀÑŠº—×Äoµ‡Äcï˜Î'Ló?Dè¶ïŽVÔ\³Ð]×ÐæƒBÀ‡øâCÌ‹ÿèT’pHLñ␀␀␀␀IEND®B`‚import gc
import logging
import os
import sys
import time

import lvgl as lv

import mpos
from mpos import Activity, AudioManager, DisplayMetrics, Intent, SDCardManager

from video_audio import AudioTrack, I2SSink, NullSink, WavSource, sidecar_path
from video_avi import AviReader, UnsupportedFormat
from video_engine import (MemoryFile, MjpegReader, Pacer, fps_from_name,
                          jpeg_dimensions, sniff_format)

logger = logging.getLogger(__name__)

try:
    import mp3dec  # noqa: F401
    _MP3_SUPPORTED = True
except ImportError:
    _MP3_SUPPORTED = False

try:
    import jpegdec
except ImportError:
    jpegdec = None

try:
    from machine import Timer
except ImportError:
    Timer = None


def _run_deferred(func):
    try:
        func()
    except Exception as e:
        logger.error("media_player: deferred %s failed: %s", func, e)


def _hide_widget(widget):
    """Hide a widget, tolerating one the screen has already deleted.

    A stop can be queued - a scheduled call on device, an LVGL async one
    elsewhere - and the activity can be torn down before it runs, so by the
    time it does, these references point at deleted objects. Nothing here
    carries the picture, so a dead widget is not an error.
    """
    if widget is None:
        return
    try:
        widget.add_flag(lv.obj.FLAG.HIDDEN)
    except lv.LvReferenceError:
        pass


def compute_stats(durations_ms):
    n = len(durations_ms)
    total = 0
    for d in durations_ms:
        total += d
    avg = total / n
    ordered = sorted(durations_ms)
    idx = n * 95 // 100
    if idx >= n:
        idx = n - 1
    return {
        "frames": n,
        "avg_ms": avg,
        "fps": 1000.0 / avg if avg > 0 else 0.0,
        "p95_ms": ordered[idx],
    }


def make_frame_rgb565(w, h, phase):
    row = bytearray()
    for x in range(w):
        r = (x * 32 // w + phase * 11) & 31
        g = (x * 64 // w + phase * 29) & 63
        b = ((w - 1 - x) * 32 // w + phase * 7) & 31
        v = (r << 11) | (g << 5) | b
        row.append(v & 255)
        row.append(v >> 8)
    buf = bytearray()
    for _ in range(h):
        buf.extend(row)
    return buf


def fps_from_name(path):
    """Get the frame rate from a name like ruler_320x240_15fps.mjpeg.

    MJPEG has no container, so the rate is not in the stream. The convention
    for the test clips is the only source; callers can also pass an explicit
    "fps" extra.
    """
    name = path.rsplit("/", 1)[-1].lower()
    end = name.find("fps")
    if end <= 0:
        return None
    start = end
    while start > 0 and name[start - 1].isdigit():
        start -= 1
    if start == end:
        return None
    try:
        value = int(name[start:end])
    except ValueError:
        return None
    return value if 1 <= value <= 120 else None


class MediaPlayer(Activity):

    FULL_W = 320
    FULL_H = 240
    HALF_W = 160
    HALF_H = 120
    N_FRAMES = 300
    DEFAULT_FPS = 15
    READ_CHUNK = 32768
    READ_CAP = 65536
    PUMP_TICK_MS = 5
    PUMP_FRAMES_PER_PASS = 4
    PUMP_MAX_WAIT_MS = 20
    VIDEO_EXTENSIONS = (".avi", ".mjpeg", ".mjpg")
    AUDIO_EXTENSIONS = (".wav", ".mp3", ".rtttl")
    AUDIO_TICK_MS = 100
    ENDLESS_REPEAT_COUNT = 1_000_000
    CONTROL_COUNT = 5
    CONTROL_WIDTH = 56
    CONTROL_PITCH = 62
    # Optional: read the clip into RAM before playing (`preload` extra). It is
    # off by default because on this board it loses: a 1.1MB clip goes from
    # 15.7 to 1.3 ms of read per frame, but the start grows by 1.7s and the
    # pump's own jitter rises from 7.5 to 19.4 ms/frame, so the framerate drops
    # (13.9 -> 11.9 fps). See docs/apps/video-performance.md.
    PRELOAD_MAX_BYTES = 3 * 1024 * 1024
    PRELOAD_HEADROOM = 1 * 1024 * 1024
    # Sound the demuxer runs ahead with before the first frame, so the sink can
    # be primed without waiting for the pump to present anything.
    AUDIO_PRIME_MS = 300
    # Media lives in a directory per kind at the card root, like /sdcard/audio.
    # The early entries keep cards that still carry the ClipTV-era clip set
    # usable without moving anything.
    PICK_START_DIRS = ("/data/video", "/sdcard/video", "/data/audio",
                       "/sdcard/audio", "/sdcard/clips", "/sdcard", "/data")
    # LVGL's sysmon prints once a second. Copying that to the console while the
    # app sits idle floods the REPL and makes an mpremote session fail, so it is
    # only echoed for a short window after the app resumes; the FPS label keeps
    # updating. 0 disables the echo entirely.
    SYSMON_LOG_MS = 8000

    def onCreate(self):
        self._timer = None
        self._bufs = {}
        self._dscs = None
        self._sysmon_samples = []
        self._sysmon_log_deadline = 0
        self._reset_run_state()
        # Playback state.
        self._playing = False
        self._reader = None
        self._play_bufs = None
        self._play_dscs = None
        self._play_dsc_i = 0
        self._play_w = 0
        self._play_h = 0
        self._stats = None
        self._pacer = None
        self._fps = self.DEFAULT_FPS
        self._play_started_ms = 0
        self._first_frame_ms = 0
        self._play_path = ""
        self._preloaded = False
        self._preload_forced = None
        self._paused = False
        self._pause_frame = 0
        self._controls_until = 0
        self._exit_requested = False
        self._seek_dragging = False
        self._seek_duration = 0
        self._reported = True
        self._own_pump = False
        self._pump_timer = None
        self._pass_pending = False
        self._task_handler = None
        # Audio state: a sidecar WAV or a stream inside the container.
        self._audio = None
        self._audio_last = None
        self._audio_used_path = ""
        self._embedded_audio = None
        # Audio-only playback through AudioManager (WAV/MP3), which brings its
        # own output selection, volume and desktop backends.
        self._audio_player = None
        self._audio_path = ""
        self._audio_timer = None
        self._audio_icon_data = None
        self._audio_icon_dsc = None
        self._audio_generation = 0
        self._audio_is_rtttl = False
        intent = self.getIntent()
        extras = getattr(intent, "extras", None) or {}
        path = extras.get("filename") or getattr(intent, "data", None)
        self._pending_path = path or None
        self._playlist = []
        self._playlist_i = 0
        self._intro_shown = False
        self._loop = False
        self._start_at_ms = 0
        self._seek_request_ms = None
        self._read_play_extras()
        self._audio_override = extras.get("audio") if "audio" in extras else None
        self._fps_forced = False
        try:
            self._fps = int(extras.get("fps")) or self.DEFAULT_FPS
            self._fps_forced = "fps" in extras and extras.get("fps") is not None
        except (TypeError, ValueError):
            self._fps = self.DEFAULT_FPS

        screen = lv.obj()
        screen.remove_flag(lv.obj.FLAG.SCROLLABLE)
        # A 1:1 clip leaves bars when it does not fill the panel; they should be
        # black rather than the theme background. This object sits behind
        # everything and only appears while a video is on screen, so the picker
        # and the labels keep the theme background.
        self.video_bg = lv.obj(screen)
        self.video_bg.set_size(lv.pct(100), lv.pct(100))
        self.video_bg.align(lv.ALIGN.CENTER, 0, 0)
        self.video_bg.set_style_bg_color(lv.color_hex(0x000000), lv.PART.MAIN)
        self.video_bg.set_style_bg_opa(lv.OPA.COVER, lv.PART.MAIN)
        self.video_bg.set_style_border_width(0, lv.PART.MAIN)
        self.video_bg.set_style_radius(0, lv.PART.MAIN)
        self.video_bg.set_style_pad_all(0, lv.PART.MAIN)
        self.video_bg.remove_flag(lv.obj.FLAG.CLICKABLE)
        self.video_bg.add_flag(lv.obj.FLAG.HIDDEN)
        self.image = lv.image(screen)
        self.image.center()
        self.image.add_flag(lv.obj.FLAG.CLICKABLE)
        self.image.add_event_cb(self._image_clicked, lv.EVENT.CLICKED, None)
        screen.add_event_cb(self._key_pressed, lv.EVENT.KEY, None)
        self.title_label = lv.label(screen)
        self.title_label.set_text("Media Player")
        self.title_label.align(lv.ALIGN.TOP_LEFT, 4, 4)
        self.status_label = lv.label(screen)
        self.status_label.set_text("idle")
        self.status_label.set_long_mode(lv.label.LONG_MODE.WRAP)
        self.status_label.set_width(lv.pct(90))
        self.status_label.align(lv.ALIGN.TOP_LEFT, 4, 28)
        # Audio mode shows the app's own icon (a video frame with a music note)
        # and the file name instead of a picture.
        self.audio_icon = lv.image(screen)
        self.audio_icon.align(lv.ALIGN.CENTER, 0, -35)
        self.audio_icon.add_flag(lv.obj.FLAG.CLICKABLE)
        self.audio_icon.add_event_cb(self._image_clicked, lv.EVENT.CLICKED, None)
        self.audio_icon.add_flag(lv.obj.FLAG.HIDDEN)
        self.audio_label = lv.label(screen)
        self.audio_label.set_text("")
        self.audio_label.set_long_mode(lv.label.LONG_MODE.WRAP)
        self.audio_label.set_width(lv.pct(90))
        self.audio_label.set_style_text_align(lv.TEXT_ALIGN.CENTER, lv.PART.MAIN)
        self.audio_label.align(lv.ALIGN.CENTER, 0, 35)
        self.audio_label.add_flag(lv.obj.FLAG.CLICKABLE)
        self.audio_label.add_event_cb(self._image_clicked, lv.EVENT.CLICKED, None)
        self.audio_label.add_flag(lv.obj.FLAG.HIDDEN)
        self._load_audio_icon()
        self.fps_label = lv.label(screen)
        self.fps_label.set_text("sysmon: - FPS")
        self.fps_label.align(lv.ALIGN.BOTTOM_LEFT, 4, -46)
        full_btn = lv.button(screen)
        full_btn.align(lv.ALIGN.BOTTOM_MID, -70, -4)
        full_btn.add_event_cb(lambda e: self.start_benchmark(self.FULL_W, self.FULL_H), lv.EVENT.CLICKED, None)
        full_lbl = lv.label(full_btn)
        full_lbl.set_text("320x240")
        full_lbl.center()
        half_btn = lv.button(screen)
        half_btn.align(lv.ALIGN.BOTTOM_MID, 70, -4)
        half_btn.add_event_cb(lambda e: self.start_benchmark(self.HALF_W, self.HALF_H), lv.EVENT.CLICKED, None)
        half_lbl = lv.label(half_btn)
        half_lbl.set_text("160x120 x2")
        half_lbl.center()
        self._full_btn = full_btn
        self._half_btn = half_btn
        open_btn = lv.button(screen)
        open_btn.align(lv.ALIGN.TOP_RIGHT, -4, -4)
        open_btn.add_event_cb(self._pick_file, lv.EVENT.CLICKED, None)
        open_lbl = lv.label(open_btn)
        open_lbl.set_text("Open")
        open_lbl.center()
        self._open_btn = open_btn
        self._bar = lv.obj(screen)
        self._bar.set_size(lv.pct(100), 66)
        self._bar.align(lv.ALIGN.BOTTOM_MID, 0, 0)
        self._bar.set_style_bg_color(lv.color_hex(0x000000), lv.PART.MAIN)
        self._bar.set_style_bg_opa(lv.OPA._70, lv.PART.MAIN)
        self._bar.set_style_border_width(0, lv.PART.MAIN)
        self._bar.set_style_radius(0, lv.PART.MAIN)
        self._bar.set_style_pad_all(0, lv.PART.MAIN)
        self._bar.remove_flag(lv.obj.FLAG.SCROLLABLE)
        self._bar.add_flag(lv.obj.FLAG.HIDDEN)
        self._seek = lv.slider(self._bar)
        self._seek.set_size(lv.pct(100) - 16, 18)
        self._seek.align(lv.ALIGN.TOP_MID, 0, 3)
        self._seek.set_range(0, 1000)
        self._seek.set_value(0, False)
        self._seek.add_event_cb(self._seek_event, lv.EVENT.PRESSED, None)
        self._seek.add_event_cb(self._seek_event, lv.EVENT.RELEASED, None)
        # Evenly spread across the bar: rewind, restart, play/pause, forward,
        # close. The FF/REW glyphs are not in the badge font, so the seek
        # controls are drawn as "<<" / ">>".
        offsets, control_width = self._control_slots(
            DisplayMetrics.width() or self._bar.get_width() or self.FULL_W)
        self._rewind_icon = self._make_control(
            self._bar, "<<", lambda e: self._seek_by(-self.SEEK_STEP_MS),
            offsets[0], control_width)
        self._restart_icon = self._make_control(
            self._bar, lv.SYMBOL.REFRESH, lambda e: self._restart_from_start(),
            offsets[1], control_width)
        self._play_icon = self._make_control(
            self._bar, lv.SYMBOL.PLAY, self._toggle_pause, offsets[2],
            control_width)
        self._forward_icon = self._make_control(
            self._bar, ">>", lambda e: self._seek_by(self.SEEK_STEP_MS),
            offsets[3], control_width)
        self._close_icon = self._make_control(
            self._bar, lv.SYMBOL.CLOSE, lambda e: self._request_exit(),
            offsets[4], control_width)

        self._overlays = [self.title_label, self.status_label, self.fps_label,
                          open_btn, full_btn, half_btn, self._bar]
        self.setContentView(screen)

    def onResume(self, screen):
        super().onResume(screen)
        self._sysmon_log_deadline = time.ticks_add(time.ticks_ms(), self.SYSMON_LOG_MS)
        lv.log_register_print_cb(self._sysmon_cb)
        if self._pending_path:
            path = self._pending_path
            self._pending_path = None
            self._playlist = []
            self._playlist_i = 0
            if not self._is_audio_path(path) and jpegdec is None:
                self.status_label.set_text("JPEG decoder not available")
                return
            self._start_media(path)
            return
        if self._audio_player is not None:
            if self._audio_player.is_playing():
                self._show_audio_view()
                self._start_audio_timer()
                return
            self._stop_audio()
            self._show_audio_view()
            self._play_icon.set_text(lv.SYMBOL.PLAY)
            self.status_label.set_text("Finished: %s" % self.audio_label.get_text())
        if not self._intro_shown:
            # Launched from the app list: show the clips instead of a blank
            # screen. Only once, so cancelling the picker does not reopen it.
            self._intro_shown = True
            self._pick_file()

    def onPause(self, screen):
        # Video owns the display pump, so it must stop. Audio keeps playing in
        # the background like the Music Player does; only its UI timer goes.
        super().onPause(screen)
        self._stop_playback()
        self._stop_timer()
        self._stop_audio_timer()
        lv.log_register_print_cb(None)
        self._bufs = {}
        self._dscs = None
        gc.collect()

    def _load_audio_icon(self):
        """Show the app icon next to the file name in audio mode."""
        for base in ("apps/com.micropythonos.media_player",
                     "builtin/apps/com.micropythonos.media_player",
                     "/builtin/apps/com.micropythonos.media_player"):
            try:
                with open(base + "/icon_64x64.png", "rb") as handle:
                    data = handle.read()
            except OSError:
                continue
            self._audio_icon_data = data
            self._audio_icon_dsc = lv.image_dsc_t({
                "data_size": len(data),
                "data": data,
            })
            self.audio_icon.set_src(self._audio_icon_dsc)
            return
        self.audio_icon.set_src(lv.SYMBOL.AUDIO)

    def _show_audio_view(self):
        self.image.add_flag(lv.obj.FLAG.HIDDEN)
        self.fps_label.add_flag(lv.obj.FLAG.HIDDEN)
        self._full_btn.add_flag(lv.obj.FLAG.HIDDEN)
        self._half_btn.add_flag(lv.obj.FLAG.HIDDEN)
        self.audio_icon.remove_flag(lv.obj.FLAG.HIDDEN)
        self.audio_label.remove_flag(lv.obj.FLAG.HIDDEN)
        self.title_label.remove_flag(lv.obj.FLAG.HIDDEN)
        self.status_label.remove_flag(lv.obj.FLAG.HIDDEN)
        self._open_btn.remove_flag(lv.obj.FLAG.HIDDEN)
        self._bar.remove_flag(lv.obj.FLAG.HIDDEN)
        self._set_audio_controls(not self._audio_is_rtttl)

    def _set_audio_controls(self, seek_enabled):
        """Show the controls the current audio format can actually honour.

        RTTTL is a buzzer tune with no sample position, so only restart and
        close make sense; hiding the scrubber and pause controls is clearer
        than leaving dead buttons on screen.
        """
        if seek_enabled:
            self._seek.remove_flag(lv.obj.FLAG.HIDDEN)
        else:
            self._seek.add_flag(lv.obj.FLAG.HIDDEN)
        controls = (self._rewind_icon, self._play_icon, self._forward_icon)
        for label in controls:
            parent = label.get_parent()
            if parent is None:
                continue
            if seek_enabled:
                parent.remove_flag(lv.obj.FLAG.HIDDEN)
            else:
                parent.add_flag(lv.obj.FLAG.HIDDEN)

    def _show_video_view(self):
        self.audio_icon.add_flag(lv.obj.FLAG.HIDDEN)
        self.audio_label.add_flag(lv.obj.FLAG.HIDDEN)
        self.image.remove_flag(lv.obj.FLAG.HIDDEN)
        self._full_btn.remove_flag(lv.obj.FLAG.HIDDEN)
        self._half_btn.remove_flag(lv.obj.FLAG.HIDDEN)
        self._open_btn.remove_flag(lv.obj.FLAG.HIDDEN)
        self._set_audio_controls(True)

    def _read_play_extras(self):
        """Loop and seek flags belong to the clip being started.

        The framework may re-use this activity for a new intent, in which case
        onCreate does not run again and last clip's flags would stick.
        """
        extras = getattr(self.getIntent(), "extras", None) or {}
        self._loop = str(extras.get("loop", "")).lower() in ("1", "true", "yes")
        preload = str(extras.get("preload", "")).lower()
        self._preload_forced = True if preload in ("1", "true", "yes") else (
            False if preload in ("0", "false", "no") else None)
        try:
            self._start_at_ms = int(extras.get("seek", 0) or 0)
        except (TypeError, ValueError):
            self._start_at_ms = 0

    CONTROLS_MS = 3000

    @staticmethod
    def _control_slots(width):
        """Evenly spaced control slots that stay on a narrow bar.

        The pitch follows the bar (capped at the 320px design's 62px) and the
        buttons shrink with it, so five controls fit a 240px screen instead of
        the outermost pair hanging past both edges.
        """
        pitch = width // MediaPlayer.CONTROL_COUNT
        if pitch > MediaPlayer.CONTROL_PITCH:
            pitch = MediaPlayer.CONTROL_PITCH
        if pitch < 16:
            pitch = 16
        button_width = MediaPlayer.CONTROL_WIDTH
        if button_width > pitch - 2:
            button_width = pitch - 2
        middle = MediaPlayer.CONTROL_COUNT // 2
        offsets = []
        for index in range(MediaPlayer.CONTROL_COUNT):
            offsets.append((index - middle) * pitch)
        return offsets, button_width

    def _make_control(self, parent, symbol, callback, x_offset, width=None):
        button = lv.button(parent)
        button.set_size(self.CONTROL_WIDTH if width is None else width, 40)
        button.align(lv.ALIGN.BOTTOM_MID, x_offset, -2)
        button.set_style_bg_opa(lv.OPA.TRANSP, lv.PART.MAIN)
        button.set_style_border_width(0, lv.PART.MAIN)
        button.set_style_shadow_width(0, lv.PART.MAIN)
        button.add_event_cb(lambda event, action=callback: action(event), lv.EVENT.CLICKED, None)
        label = lv.label(button)
        label.set_text(symbol)
        label.set_style_text_color(lv.color_hex(0xFFFFFF), lv.PART.MAIN)
        label.set_style_text_font(lv.font_montserrat_20, lv.PART.MAIN)
        label.center()
        return label

    def _focus_image(self):
        """Make the picture the focused object for the duration of playback.

        A/ENTER then sends CLICKED to it (pause) instead of activating an
        overlay button that is not even on screen.
        """
        group = lv.group_get_default()
        if group is None:
            return
        try:
            group.add_obj(self.image)
            lv.group_focus_obj(self.image)
        except Exception as e:
            logger.error("media_player: cannot focus the picture: %s", e)

    def _show_controls(self, ms=None):
        self._bar.remove_flag(lv.obj.FLAG.HIDDEN)
        self._controls_until = 0 if ms is None else time.ticks_ms() + ms
        self._update_play_icon()
        # The bar was hidden while playing, so the scrubber still holds the
        # position it had when it last showed (usually 0). Put it where
        # playback actually is, or tapping to pause shows a stale slider.
        self._sync_scrubber()

    def _hide_controls(self):
        _hide_widget(self._bar)
        self._controls_until = 0

    def _update_play_icon(self):
        self._play_icon.set_text(lv.SYMBOL.PLAY if self._paused else lv.SYMBOL.PAUSE)

    def _request_exit(self):
        """Leave without tearing down from inside the pump's callback.

        On device the pump runs from a machine.Timer callback. Finishing the
        activity (and deinit()-ing that timer) from inside it left the device
        unresponsive; the same applies when the request arrives from a gesture
        event, which the pump dispatches inside its own LVGL pass.
        """
        if self._exit_requested:
            return
        self._exit_requested = True
        self._defer(self._finish_now)

    def _defer(self, func):
        """Run func outside the pump callback and outside the LVGL pass."""
        if self._own_pump:
            try:
                import micropython
                micropython.schedule(_run_deferred, func)
                return
            except Exception as e:
                logger.error("media_player: cannot schedule the exit: %s", e)
        lv.async_call(lambda _: _run_deferred(func), None)

    def _finish_now(self):
        """Stop playback, then finish only while this is the top activity.

        Another activity can be pushed while the exit is deferred (an app was
        launched, the caller went back); finish() would then pop that activity
        instead of this one.
        """
        self._stop_playback()
        self._stop_audio()
        if self.has_foreground():
            self.finish()

    def onBackPressed(self, screen):
        """Consume the back gesture and leave through the deferred path."""
        self._request_exit()
        return True

    def _pick_file(self, event=None):
        self.status_label.set_text("pick a file")
        patterns = list(self.VIDEO_EXTENSIONS) + list(self.AUDIO_EXTENSIONS)
        if not _MP3_SUPPORTED:
            patterns.remove(".mp3")
        intent = Intent(
            action="pick_file",
            extras={"start_dir": self._pick_start_dir(),
                    "path_pattern": patterns},
        )
        self.startActivityForResult(intent, self._on_file_picked)

    def _pick_start_dir(self):
        for path in self.PICK_START_DIRS:
            try:
                if os.stat(path)[0] & 0x4000:
                    return path
            except OSError:
                continue
        return "/"

    def _on_file_picked(self, result):
        if not result or not result.get("result_code"):
            self.status_label.set_text("Tap Open to choose a file")
            return
        paths = result.get("data", {}).get("paths", [])
        media = self._media_from(paths)
        if not media:
            self.status_label.set_text("No playable media in there")
            return
        self._playlist = media
        self._playlist_i = 0
        self._start_media(media[0])

    def _media_from(self, paths):
        """Expand picked files and folders into the media to play, in order.

        Picking a folder means "play everything in it": the items run in name
        order, which is the order a naming scheme like 01_... already gives.
        Folders may mix video and audio; each item is routed when it starts.
        """
        media = []
        seen = set()
        for path in paths:
            if path.endswith("/"):
                try:
                    names = sorted(os.listdir(path.rstrip("/") or "/"))
                except OSError:
                    continue
                for name in names:
                    if not self._is_media_path(name):
                        continue
                    item = path + name
                    if item not in seen:
                        seen.add(item)
                        media.append(item)
            elif self._is_media_path(path):
                if path not in seen:
                    seen.add(path)
                    media.append(path)
        return media

    def _is_audio_path(self, path):
        lower = path.lower()
        if lower.endswith(".mp3"):
            return _MP3_SUPPORTED
        return lower.endswith((".wav", ".rtttl"))

    def _is_media_path(self, path):
        lower = path.lower()
        if lower.endswith(self.VIDEO_EXTENSIONS):
            return True
        return self._is_audio_path(path)

    def _advance_playlist(self):
        """Start the next item of a folder pick; wrap around only when looping."""
        if not self._playlist:
            return False
        nxt = self._playlist_i + 1
        if nxt >= len(self._playlist):
            if not self._loop:
                return False
            nxt = 0
        self._playlist_i = nxt
        self._start_media(self._playlist[nxt])
        return True

    def _start_media(self, path):
        """Route one file to the video pump or the AudioManager player."""
        self._stop_playback()
        self._stop_audio(wait=True)
        if path.lower().endswith(".mp3") and not _MP3_SUPPORTED:
            self._show_audio_view()
            self.audio_label.set_text(path.rsplit("/", 1)[-1])
            self._audio_failed("Error: MP3 playback needs a newer firmware")
            return
        if self._is_audio_path(path):
            self._start_audio(path)
        elif jpegdec is None:
            self._show_video_view()
            self._show_overlays()
            self.status_label.set_text("JPEG decoder not available")
        else:
            self._start_clip(path)

    def _start_clip(self, path):
        # A clip can be started while another one is playing (picking a new
        # file, a folder result, a second launch). Two pumps on one screen
        # fight over the reader and the display, so the old one goes first.
        if self._playing:
            self._stop_playback()
        if not self._fps_forced:
            self._fps = fps_from_name(path) or self._fps
        self._show_video_view()
        self._play(path)

    def _is_active(self):
        return self._playing or self._audio_player is not None

    def _image_clicked(self, event):
        if not self._is_active():
            return
        self._toggle_pause()
        self._show_controls(None if self._audio_player is not None else self.CONTROLS_MS)

    def _key_pressed(self, event):
        if not self._is_active():
            return
        key = event.get_key()
        if key == lv.KEY.NEXT:
            self._seek_by(self.SEEK_STEP_MS)
            self._show_controls(None if self._audio_player is not None else self.CONTROLS_MS)
        elif key == lv.KEY.PREV:
            self._seek_by(-self.SEEK_STEP_MS)
            self._show_controls(None if self._audio_player is not None else self.CONTROLS_MS)
        elif key == lv.KEY.ESC:
            self._request_exit()

    # ------------------------------------------------------------------
    #  Audio playback (WAV/MP3) through AudioManager.
    #  The video pump owns the display; audio gets its own small timer that
    #  only refreshes the control bar.
    # ------------------------------------------------------------------

    def _start_audio(self, path):
        self._read_play_extras()
        self._playing = False
        self._paused = False
        self._exit_requested = False
        self._stats = None
        self._reader = None
        self._pacer = None
        self._play_path = path
        self._audio_path = path
        self._audio_is_rtttl = path.lower().endswith(".rtttl")
        self._audio_generation += 1
        generation = self._audio_generation
        self._show_audio_view()
        self.audio_label.set_text(path.rsplit("/", 1)[-1])
        self.status_label.set_text("")
        self._show_controls(None)
        self._update_play_icon()
        self._focus_audio()
        SDCardManager.mount()

        if path.lower().endswith(".mp3") and not _MP3_SUPPORTED:
            self._audio_failed("Error: MP3 playback needs a newer firmware")
            return

        output = AudioManager.get_default_output()
        if output is None:
            self._audio_failed("Error: No audio output available")
            return

        rtttl_string = None
        if self._audio_is_rtttl:
            if getattr(output, "kind", None) != "buzzer":
                output = self._find_buzzer_output()
                if output is None:
                    self._audio_failed("Error: RTTTL requires a buzzer output")
                    return
            try:
                with open(path) as handle:
                    rtttl_string = handle.read().strip()
            except Exception as exc:
                logger.error("media_player: cannot read %s: %s", path, exc)
                self._audio_failed("Error: Could not read RTTTL file")
                return
            if rtttl_string.count(":") < 2:
                self._audio_failed("Error: Invalid RTTTL file")
                return

        # Let any other AudioManager playback (the Music Player, a
        # notification) release the I2S or buzzer before taking it.
        self._quiet_other_audio()
        try:
            player_kwargs = dict(
                stream_type=AudioManager.STREAM_MUSIC,
                on_complete=lambda result, token=generation:
                    self._audio_complete(token, result),
                output=output,
            )
            if rtttl_string is not None:
                player_kwargs["rtttl"] = rtttl_string
            else:
                player_kwargs["file_path"] = path
            player = AudioManager.player(**player_kwargs)
            player.set_repeat(
                self.ENDLESS_REPEAT_COUNT
                if self._loop and len(self._playlist) <= 1 else 1)
            self._audio_player = player
            player.start()
        except Exception as exc:
            logger.error("media_player: cannot start %s: %s", path, exc)
            self._audio_player = None
            self._audio_failed("Error: Audio device unavailable or busy")
            return
        self._start_audio_timer()

    @staticmethod
    def _find_buzzer_output():
        for output in AudioManager.get_outputs():
            if getattr(output, "kind", None) == "buzzer":
                return output
        return None

    def _audio_failed(self, message):
        self._stop_audio_timer()
        self._audio_player = None
        self._audio_path = ""
        self._playing = False
        self._paused = False
        self._show_controls(None)
        self._play_icon.set_text(lv.SYMBOL.PLAY)
        self.status_label.set_text(message)
        print("media_player: %s" % message)

    def _audio_complete(self, generation, result=None):
        # Runs on the AudioManager player thread; LVGL is only touched through
        # the activity's deferred UI update.
        self.update_ui_threadsafe_if_foreground(
            self._on_audio_finished, generation, result)

    def _on_audio_finished(self, generation, result=None):
        if generation != self._audio_generation or self._audio_player is None:
            # A stop() from switching files also reports completion; ignore
            # the callbacks of players that are no longer current.
            return
        if result and str(result).lower().startswith("error"):
            self._audio_failed(result)
            return
        # The player thread is already finishing. Drop our handle first so a
        # playlist transition does not wait for a stop() that has nothing to
        # stop (the stream's finally block is about to release the output).
        self._audio_player = None
        self._stop_audio_timer()
        if self._advance_playlist():
            return
        if self._loop and self._restart_audio():
            return
        self._audio_path = ""
        self._paused = False
        self._update_play_icon()
        self.status_label.set_text("Finished: %s" % self.audio_label.get_text())
        self._show_controls(None)
        self._play_icon.set_text(lv.SYMBOL.PLAY)

    def _restart_audio(self):
        path = self._audio_path
        if not path:
            return False
        self._stop_audio(wait=True)
        self._start_audio(path)
        return True

    def _start_audio_timer(self):
        self._stop_audio_timer()
        if self._audio_player is None or self._audio_is_rtttl:
            return
        self._audio_timer = lv.timer_create(self._audio_tick, self.AUDIO_TICK_MS, None)
        self._audio_timer.set_repeat_count(-1)

    def _stop_audio_timer(self):
        timer = self._audio_timer
        self._audio_timer = None
        if timer is not None:
            try:
                timer.delete()
            except Exception as e:
                logger.error("media_player: audio timer stop failed: %s", e)

    def _audio_tick(self, timer=None):
        if self._audio_player is None:
            self._stop_audio_timer()
            return
        self._sync_scrubber()

    def _stop_audio(self, wait=False):
        self._stop_audio_timer()
        player = self._audio_player
        self._audio_player = None
        self._audio_path = ""
        self._paused = False
        if player is not None:
            try:
                player.stop()
            except Exception as e:
                logger.error("media_player: audio stop failed: %s", e)
            if wait:
                # The playback thread tears its I2S down in its finally block.
                # Opening the next stream before that happens would let the
                # old deinit() pull the peripheral out from under it.
                deadline = time.ticks_add(time.ticks_ms(), 500)
                while (player.is_playing()
                       and time.ticks_diff(deadline, time.ticks_ms()) > 0):
                    time.sleep_ms(10)

    def _focus_audio(self):
        group = lv.group_get_default()
        if group is None:
            return
        try:
            group.add_obj(self.audio_label)
            lv.group_focus_obj(self.audio_label)
        except Exception as e:
            logger.error("media_player: cannot focus the audio view: %s", e)

    # ------------------------------------------------------------------
    #  MJPEG playback: read -> decode -> set_src -> refr_now -> pace.
    #  One frame per timer callback, always 1:1 (no LVGL scaling).
    # ------------------------------------------------------------------

    def _play(self, path):
        self._read_play_extras()
        self._playing = True
        self._paused = False
        self._exit_requested = False
        self._hide_controls()
        self._focus_image()
        self._reported = False
        self._play_path = path
        self._play_started_ms = time.ticks_ms()
        self._stats = {
            "read_us": 0,
            "decode_us": 0,
            "set_src_us": 0,
            "refr_us": 0,
            "skip_us": 0,
            "present_us": 0,
            "lvgl_us": 0,
            "pass_us": 0,
            "audio_us": 0,
            "sleep_us": 0,
            "ticks": 0,
            "presented": 0,
            "dropped": 0,
            "seeked": 0,
            "frames_read": 0,
        }
        self.status_label.set_text("loading...")
        SDCardManager.mount()
        self._embedded_audio = None
        clip_data = self._load_clip(path)
        self._preloaded = clip_data is not None
        if self._preloaded:
            print("media_player: preloaded %s (%d bytes)"
                  % (path.rsplit("/", 1)[-1], len(clip_data)))
        try:
            self._reader = self._open_reader(path, clip_data)
            if isinstance(self._reader, AviReader):
                if self._reader.fps and not self._fps_forced:
                    self._fps = self._reader.fps
                try:
                    self._embedded_audio = self._reader.audio_source()
                except UnsupportedFormat as e:
                    # Play the pictures, say why there is no sound.
                    logger.warning("media_player: %s: %s", path, e.message)
                    print("media_player: %s" % e.message)
                    self.status_label.set_text(e.message)
            # Open the sound sink before reading the first frame: its startup
            # silence drains in real time (up to 372ms), so the read, the
            # buffer allocation and the first decode all happen inside that
            # wait instead of after it.
            self._open_audio(path)
            self._prefill_audio()
            frame = self._reader.next()
        except UnsupportedFormat as e:
            logger.error("media_player: %s: %s", path, e.message)
            self._play_failed(e.message)
            return
        except OSError as e:
            logger.error("media_player: cannot open %s: %s", path, e)
            self._play_failed("cannot open %s" % path)
            return
        if frame is None:
            self._play_failed("no frames in %s" % path)
            return
        w, h = jpeg_dimensions(frame)
        if not w or not h:
            logger.error("media_player: %s is not a JPEG stream", path)
            self._play_failed("not a JPEG stream")
            return
        self._play_w, self._play_h = w, h
        frame_bytes = w * h * 2
        self._play_bufs = [bytearray(frame_bytes)]
        try:
            # Two targets so the decoder never writes the frame the panel is
            # still flushing. One is a degraded but working fallback.
            self._play_bufs.append(bytearray(frame_bytes))
        except MemoryError:
            logger.warning("media_player: single decode buffer (MemoryError)")
        self._play_dscs = [self._make_dsc(w, h, b) for b in self._play_bufs]
        self._play_dsc_i = 0
        self._prepare_image(w, h)
        t = time.ticks_us()
        try:
            jpegdec.decode(frame, self._play_bufs[0])
        except Exception as e:
            logger.error("media_player: decode failed: %s", e)
            self._play_failed("decode failed")
            return
        self._stats["decode_us"] += time.ticks_diff(time.ticks_us(), t)
        self._stats["frames_read"] = 1
        self._hide_overlays()
        # Drain the sink's startup silence before anything is shown: that wait
        # is up to a fifth of a second and would otherwise sit between the
        # first frame and sample 0.
        self._audio_ready()
        self.image.set_src(self._play_dscs[0])
        lv.refr_now(None)
        # Frame 0 is on the panel now. The prime lands in microseconds, so
        # sample 0 starts on this same instant and both clocks start here.
        audio_ms = self._audio_start(time.ticks_ms())
        self._stats["presented"] = 1
        now = time.ticks_ms()
        first_ms = time.ticks_diff(now, self._play_started_ms)
        self._first_frame_ms = first_ms
        self._pacer = Pacer(self._fps, audio_ms)
        self._pacer.mark_shown(audio_ms)
        print("media_player: play %s %dx%d %dfps, first frame %dms" % (
            path, w, h, self._fps, first_ms))
        if self._start_at_ms > 0:
            self._seek_request_ms = self._start_at_ms
        self._start_pump()

    def _open_reader(self, path, data=None):
        """Open the demuxer that matches the file, with a readable failure."""
        lower = path.lower()
        source = MemoryFile(data) if data is not None else path
        if lower.endswith(".avi"):
            return AviReader(source)
        if lower.endswith((".mjpeg", ".mjpg")):
            kind = sniff_format(source)
            if kind and "MJPEG" not in kind and "JPEG" not in kind:
                raise UnsupportedFormat(
                    "%s is %s, not MJPEG (this player decodes MJPEG only)"
                    % (path.rsplit("/", 1)[-1], kind))
            return MjpegReader(source, self.READ_CHUNK, self.READ_CAP)
        raise UnsupportedFormat(
            "unsupported video file: %s (this player opens .avi, .mjpeg and .mjpg)"
            % path.rsplit("/", 1)[-1])

    def _play_failed(self, message):
        self._playing = False
        self._stop_playback()
        self._show_overlays()
        self.status_label.set_text(message)
        print("media_player: %s" % message)

    def _prepare_image(self, w, h):
        # 1:1 always. Scaling in the draw path costs ~10x the flush.
        self.image.set_scale(256)
        self.image.set_size(w, h)
        self.image.center()
        self.video_bg.remove_flag(lv.obj.FLAG.HIDDEN)
        # A frame bigger than the panel loses its edges to the centred image,
        # and nothing else would say so.
        disp_w = DisplayMetrics.width() or self.FULL_W
        disp_h = DisplayMetrics.height() or self.FULL_H
        if w > disp_w or h > disp_h:
            message = ("%dx%d clip: only the centre %dx%d is shown "
                       "(re-encode to fit)" % (w, h, disp_w, disp_h))
            logger.warning("media_player: %s", message)
            self.status_label.set_text(message)

    # ----- seeking and looping -------------------------------------------

    SEEK_STEP_MS = 15000

    def _position_ms(self):
        if self._audio_player is not None:
            position = self._audio_player.get_progress_ms()
            return position or 0
        pacer = self._pacer
        if pacer is None:
            return 0
        return pacer.frame * 1000 // self._fps

    def _seek_by(self, delta_ms):
        self._request_seek(self._position_ms() + delta_ms)

    def _request_seek(self, ms):
        """Ask for a seek; the pump performs it.

        The pump runs in a timer callback, so it is the only context that may
        touch the demuxer: seeking from here used to pull the frame queue out
        from under it. AudioManager's streams take a seek request from here
        and perform it on their own playback thread.
        """
        if self._audio_player is not None:
            if self._audio_is_rtttl:
                return
            if ms < 0:
                ms = 0
            self._audio_player.seek(ms)
            return
        self._seek_request_ms = ms

    def _apply_seek(self, ms):
        """Jump both streams to ms."""
        if ms < 0:
            ms = 0
        if self._fps <= 0:
            self._fps = self.DEFAULT_FPS
        return self._restart_at(ms * self._fps // 1000, resume=not self._paused)

    def _restart_from_start(self):
        if self._audio_is_rtttl:
            self._restart_audio()
        else:
            self._request_seek(0)

    def _toggle_pause(self, event=None):
        if self._audio_player is not None:
            if self._audio_is_rtttl:
                return
            if self._paused:
                self._paused = False
                self._audio_player.resume()
            else:
                self._paused = True
                self._audio_player.pause()
            self._show_controls(None)
            self._update_play_icon()
            return
        if not self._playing:
            return
        if self._paused:
            frame = self._pause_frame
            self._paused = False
            self._restart_at(frame)
            self._show_controls(self.CONTROLS_MS)
        else:
            self._paused = True
            self._pause_frame = self._pacer.frame if self._pacer else 0
            # Stop the sound with the picture; resuming reopens the sink, which
            # also gets rid of the ~180ms still queued before the pause.
            self._close_audio()
            self._show_controls(None)
        self._update_play_icon()

    def _restart(self):
        """Loop: start the clip again from the first frame."""
        return self._restart_at(0)

    def _restart_at(self, frame, resume=True):
        """Rewind and resume at `frame`, reopening the sound like a fresh start.

        The sink keeps ~180ms of the old sound queued, so priming on top of it
        would leave the new position mixed with the old one; closing and
        reopening it is the same path a normal start takes and costs the ring's
        drain (~370ms). With resume=False (a seek while paused) it shows the
        frame at the new position and stays paused.
        """
        reader = self._reader
        if not self._playing or reader is None:
            return False
        if frame < 0:
            frame = 0
        try:
            reader.rewind()
            if frame:
                if isinstance(reader, AviReader):
                    # Walk the frames, but not their sound: a seek moves the
                    # soundtrack, it does not play what it passed.
                    reader.skip(frame, False)
                else:
                    reader.skip(frame)
        except Exception as e:
            logger.error("media_player: seek failed: %s", e)
            return False
        if not resume:
            # Scrub preview: present the frame at the new position, no sound.
            self._close_audio()
            self._pacer = Pacer(self._fps, time.ticks_ms() - frame * 1000 // self._fps)
            self._pacer.frame = frame
            self._paused = False
            self._frame_tick()
            self._paused = True
            return True
        self._close_audio()
        if isinstance(reader, AviReader):
            try:
                self._embedded_audio = reader.audio_source()
            except UnsupportedFormat as e:
                logger.warning("media_player: %s", e.message)
                self._embedded_audio = None
        self._open_audio(self._play_path)
        self._prefill_audio()
        now = time.ticks_ms()
        # The pacer counts frames from its start, so back-date it by the frames
        # skipped: otherwise it would wait that long before the next frame.
        self._pacer = Pacer(self._fps, now - frame * 1000 // self._fps)
        self._pacer.frame = frame
        self._pacer.mark_shown(now)
        self._audio_start(now)
        self._playing = True
        if frame == 0:
            print("media_player: loop restart at %d frames" % self._stats["presented"])
        return True

    # ----- audio sidecar -------------------------------------------------
    #
    # The pump feeds the sink, it does not run an AudioManager player: that
    # starts a reader thread of its own, and the two would take turns on the
    # one SD card (already the bottleneck). A refill is one small read plus one
    # I2S write, and it happens between frames, so it costs the frame budget
    # a few ms instead of a whole frame.

    def _open_audio(self, video_path):
        self._audio = None
        self._audio_last = None
        self._audio_used_path = ""
        path = None
        source = self._embedded_audio
        self._embedded_audio = None
        if source is None:
            override = self._audio_override
            if override is not None:
                path = override or None
            else:
                path = sidecar_path(video_path)
            if not path:
                return
        output = None
        if sys.platform == "esp32":
            audio_manager = getattr(mpos, "AudioManager", None)
            output = audio_manager.get_default_output() if audio_manager else None
            if output is None or output.kind != "i2s":
                output = None
        if source is None:
            try:
                source = WavSource(path, preferred_rate=getattr(output, "preferred_sample_rate", None))
            except (OSError, ValueError) as e:
                logger.error("media_player: audio %s unusable: %s", path, e)
                print("media_player: audio %s unusable: %s" % (path, e))
                return
        try:
            if output is not None:
                self._quiet_other_audio()
                sink = I2SSink(output, source.playback_rate, source.channels)
            else:
                sink = NullSink()
            sink.open()
        except Exception as e:
            logger.error("media_player: audio sink failed: %s", e)
            print("media_player: audio sink failed: %s" % e)
            source.close()
            return
        # Preload after the sink is open: reading a few hundred kilobytes
        # takes longer than the ring's startup silence, so the wait costs
        # nothing on the way to the first frame.
        source.preload()
        self._audio = AudioTrack(source, sink)
        self._audio_used_path = path or video_path
        print("media_player: audio %s %s %dHz %s %s" % (
            path or ("in " + video_path.rsplit("/", 1)[-1]), source.format_name,
            source.playback_rate, "mono" if source.channels == 1 else "stereo",
            "in RAM" if source.in_memory else "streaming"))

    def _quiet_other_audio(self):
        """Stop a background player before taking the I2S peripheral.

        Two users of ``machine.I2S(0)`` is not a supported state, and the
        music player closes its own handle from its thread. Stop it and give
        that thread time to finish, or it would deinit our new sink a moment
        after it opens.
        """
        audio_manager = getattr(mpos, "AudioManager", None)
        if audio_manager is None:
            return
        try:
            if audio_manager.get_active_player() is None:
                return
            audio_manager.stop()
            deadline = time.ticks_ms() + 500
            while time.ticks_ms() < deadline:
                if audio_manager.get_active_player() is None:
                    break
                time.sleep_ms(20)
        except Exception as e:
            logger.error("media_player: cannot stop background audio: %s", e)

    def _load_clip(self, path):
        """Read the whole clip into RAM when that is worth it; else None."""
        if self._preload_forced is False:
            return None
        try:
            size = os.stat(path)[6]
        except OSError:
            return None
        if size <= 0 or size > self.PRELOAD_MAX_BYTES:
            return None
        if self._preload_forced is None:
            return None
        if gc.mem_free() < size + self.PRELOAD_HEADROOM:
            logger.warning("media_player: not enough RAM to preload %s", path)
            return None
        data = bytearray(size)
        view = memoryview(data)
        read = 0
        try:
            handle = open(path, "rb")
        except OSError as e:
            logger.error("media_player: cannot preload %s: %s", path, e)
            return None
        try:
            while read < size:
                count = size - read
                if count > 65536:
                    count = 65536
                got = handle.readinto(view[read:read + count])
                if not got:
                    break
                read += got
        finally:
            handle.close()
        if read != size:
            logger.warning("media_player: short preload of %s", path)
            return None
        return data

    def _prefill_audio(self):
        reader = self._reader
        if not isinstance(reader, AviReader) or reader.feed is None:
            return
        try:
            reader.prefill_audio(self.AUDIO_PRIME_MS)
        except Exception as e:
            logger.error("media_player: audio prefill failed: %s", e)

    def _audio_ready(self):
        if self._audio is None:
            return
        try:
            self._audio.ready()
        except Exception as e:
            logger.error("media_player: audio sink not ready: %s", e)
            self._close_audio()

    def _audio_start(self, now_ms):
        if self._audio is None:
            return now_ms
        try:
            return self._audio.start(now_ms)
        except Exception as e:
            logger.error("media_player: audio start failed: %s", e)
            self._close_audio()
            return now_ms

    def _audio_tick(self, now_ms):
        audio = self._audio
        if audio is None or audio.finished:
            return
        try:
            audio.tick(now_ms)
        except Exception as e:
            logger.error("media_player: audio failed: %s", e)
            print("media_player: audio failed: %s" % e)
            try:
                sys.print_exception(e)  # NOQA
            except Exception:
                pass
            self._close_audio()

    def _close_audio(self):
        audio = self._audio
        self._audio = None
        if audio is None:
            return
        self._audio_last = audio
        try:
            audio.stop()
        except Exception as e:
            logger.error("media_player: audio stop failed: %s", e)

    def _audio_report(self):
        audio = self._audio_last
        if audio is None:
            return "no audio"
        frames = (self._stats or {}).get("presented") or 1
        # Both streams follow one clock and a resync jumps the sound forward,
        # so drift is zero by construction; what the run costs is the sound it
        # had to drop to keep that promise.
        rate = audio.clock.byte_rate
        dropped_ms = audio.skipped * 1000 // rate if rate else 0
        total = audio.written + audio.skipped
        dropped_pct = audio.skipped * 100.0 / total if total else 0.0
        return "%s %dHz %s%s: wrote %dB, dropped %dms of sound (%.1f%%) in %d " \
            "resyncs, %d underruns, queue min %dms, read %.2fms write %.2fms " \
            "per frame" % (
                audio.source.format_name, audio.rate,
                "mono" if audio.channels == 1 else "stereo",
                " RAM" if audio.preloaded else " stream",
                audio.written, dropped_ms, dropped_pct, audio.resyncs,
                audio.underruns, audio.min_pending_ms,
                audio.read_us / 1000.0 / frames,
                audio.write_us / 1000.0 / frames)

    # ----- frame pump -------------------------------------------------
    #
    # Where the frame work runs decides how much of the frame budget survives.
    # Inside a framework TaskHandler pass it is charged a quarter of its own
    # duration as a fairness gap before the next pass may start: at 320x240 a
    # frame costs ~65ms of reading, decoding and flushing, so the gap alone
    # (16-21ms) exceeds the 1.6ms of headroom a 15fps clip has. The pump
    # therefore runs its own LVGL passes from a hardware timer on device, and
    # hands them back to the framework when the clip ends.

    def _start_pump(self):
        self._pass_pending = False
        self._own_pump = False
        if self._take_over_passes():
            self._own_pump = True
            self._pump_timer = self._new_pump_timer()
            if self._pump_timer is None:
                self._own_pump = False
                self._give_back_passes()
        if self._own_pump:
            self._set_pump_period(1)
            return
        self._pump_timer = lv.timer_create(self._pump, 1, None)
        self._pump_timer.set_repeat_count(-1)

    def _take_over_passes(self):
        if sys.platform != "esp32":
            return False
        task_handler = getattr(getattr(mpos, "ui", None), "task_handler", None)
        if task_handler is None:
            return False
        try:
            task_handler.disable()
        except Exception as e:
            logger.error("media_player: cannot take over LVGL passes: %s", e)
            return False
        self._task_handler = task_handler
        return True

    def _give_back_passes(self):
        task_handler = self._task_handler
        self._task_handler = None
        if task_handler is None:
            return
        try:
            task_handler.enable()
        except Exception as e:
            logger.error("media_player: cannot return LVGL passes: %s", e)

    def _new_pump_timer(self):
        # ESP32 has hardware timers 0-3; the task handler owns 0 and the
        # connectivity manager takes 1.
        timer = None
        for timer_id in (3, 2, -1):
            try:
                timer = Timer(timer_id)
                break
            except Exception:
                continue
        if timer is None:
            return None
        try:
            timer.init(mode=Timer.PERIODIC, period=self.PUMP_TICK_MS,
                       callback=self._pump_isr)
        except Exception as e:
            logger.error("media_player: no pump timer: %s", e)
            return None
        return timer

    def _pump_isr(self, timer):
        # The pass runs here, not through micropython.schedule(): a scheduled
        # callback only runs when the main thread next yields, and that was
        # measured at 25-75ms, which is most of a small clip's frame budget.
        # The timer keeps a fixed tick; the pass sleeps out the rest of the
        # wait, because re-arming a timer from inside its own callback hangs.
        if self._pass_pending:
            return
        self._pass_pending = True
        try:
            self._pump_pass(0)
        finally:
            self._pass_pending = False

    def _pump_pass(self, _):
        try:
            if self._exit_requested:
                return
            # A seek must land even while paused: that is how scrubbing works.
            self._service_seek()
            if self._paused:
                # Keep the UI alive (the bar's buttons are LVGL widgets) without
                # touching the frame timeline.
                try:
                    lv.task_handler()
                except Exception as e:
                    logger.error("media_player: LVGL pass failed: %s", e)
                time.sleep_ms(self.PUMP_TICK_MS)
                return
            # Present every frame that is due in one callback. Waiting for the
            # next tick between frames would add up to a tick of dead time to
            # each one, which at 320x240 is 5ms out of a 66ms budget.
            for _ in range(self.PUMP_FRAMES_PER_PASS):
                if not self._playing:
                    return
                self._service_seek()
                now = time.ticks_ms()
                t = time.ticks_us()
                self._audio_tick(now)
                stats = self._stats
                if stats is not None:
                    stats["audio_us"] += time.ticks_diff(time.ticks_us(), t)
                wait = self._pacer.wait_ms(now)
                if wait > 1:
                    # The frame is not due yet: return and let the timer fire
                    # again in a tick. Sleeping out the gap inside this callback
                    # is what keeps the interpreter (and therefore the console)
                    # from running while a clip plays; the audio refill and the
                    # frame timing stay on the same tick grid either way.
                    return
                self._service_controls()
                stats = self._stats
                stats["ticks"] += 1
                pass_start = time.ticks_us()
                t = pass_start
                try:
                    lv.task_handler()
                except Exception as e:
                    logger.error("media_player: LVGL pass failed: %s", e)
                stats["lvgl_us"] += time.ticks_diff(time.ticks_us(), t)
                self._frame_tick()
                stats["pass_us"] += time.ticks_diff(time.ticks_us(), pass_start)
        except Exception as e:
            # Never leave the framework without its passes: that freezes the
            # whole UI, so stop playback and hand LVGL back instead. The stop
            # itself is deferred: deinit()-ing the pump timer from inside its
            # callback is what wedges the chip.
            logger.error("media_player: pump pass failed: %s", e)
            sys.print_exception(e)  # NOQA
            self._exit_requested = True
            self._defer(self._stop_playback)
        finally:
            self._pass_pending = False

    def _seek_event(self, event):
        if event.get_code() == lv.EVENT.PRESSED:
            self._seek_dragging = True
        elif event.get_code() == lv.EVENT.RELEASED:
            self._seek_dragging = False
            self._request_seek(self._seek.get_value())

    def _duration_ms(self):
        """Length of the clip or track, or 0 when it cannot be known yet."""
        if self._audio_player is not None:
            duration = self._audio_player.get_duration_ms()
            return duration or 0
        reader = self._reader
        if reader is None or self._fps <= 0:
            return 0
        frames = getattr(reader, "frame_count", 0) or 0
        if not frames:
            # Raw MJPEG has no index: estimate from the average frame size.
            size = getattr(reader, "_size", 0) or 0
            seen = getattr(reader, "frames", 0) or 0
            if size and seen:
                frames = size * seen // reader.sum_frame_bytes
        return frames * 1000 // self._fps

    def _sync_scrubber(self):
        if self._seek_dragging:
            return
        duration = self._duration_ms()
        if duration > 0:
            if duration != self._seek_duration:
                self._seek.set_range(0, duration)
                self._seek_duration = duration
            position = self._position_ms()
            if position > duration:
                position = duration
            self._seek.set_value(position, False)

    def _service_controls(self):
        """Hide the bar once its time is up, unless playback is paused."""
        if self._controls_until and not self._paused:
            if time.ticks_ms() >= self._controls_until:
                self._hide_controls()
            else:
                self._sync_scrubber()

    def _service_seek(self):
        ms = self._seek_request_ms
        if ms is None:
            return
        self._seek_request_ms = None
        self._apply_seek(ms)

    def _pump(self, timer=None):
        # Desktop fallback: the framework keeps passing, an LVGL timer pumps.
        if not self._playing:
            return
        if self._exit_requested:
            return
        self._service_seek()
        if self._paused:
            return
        self._service_controls()
        stats = self._stats
        stats["ticks"] += 1
        pass_start = time.ticks_us()
        self._audio_tick(time.ticks_ms())
        self._set_pump_period(self._frame_tick())
        stats["pass_us"] += time.ticks_diff(time.ticks_us(), pass_start)

    def _frame_tick(self):
        """Present one frame if it is due; return ms until the next check."""
        if not self._playing or self._paused:
            return 1
        stats = self._stats
        now = time.ticks_ms()
        wait = self._pacer.wait_ms(now)
        if wait > 1:
            return wait
        frame_start = time.ticks_us()
        t = frame_start
        frame = self._reader.next()
        stats["read_us"] += time.ticks_diff(time.ticks_us(), t)
        if frame is None:
            if self._advance_playlist():
                return 1
            if self._loop and self._restart():
                return 1
            self._request_exit()
            return 0
        stats["frames_read"] += 1
        buf = self._play_bufs[self._play_dsc_i]
        t = time.ticks_us()
        try:
            jpegdec.decode(frame, buf)
        except Exception as e:
            logger.error("media_player: decode failed: %s", e)
            return 1
        stats["decode_us"] += time.ticks_diff(time.ticks_us(), t)
        dsc = self._play_dscs[self._play_dsc_i]
        self._play_dsc_i = (self._play_dsc_i + 1) % len(self._play_dscs)
        t = time.ticks_us()
        self.image.set_src(dsc)
        stats["set_src_us"] += time.ticks_diff(time.ticks_us(), t)
        t = time.ticks_us()
        lv.refr_now(None)
        stats["refr_us"] += time.ticks_diff(time.ticks_us(), t)
        stats["present_us"] += time.ticks_diff(time.ticks_us(), frame_start)
        stats["presented"] += 1
        now = time.ticks_ms()
        # Drop frames to keep wall-clock time. Reading a dropped frame costs its
        # bytes at SD speed, which on a saturated stream is the whole budget, so
        # seek past it when that is cheaper. Skipping is only worth it once the
        # presenting work alone cannot keep up: otherwise the resync read after
        # the seek costs more than the frame it avoided.
        skip = self._pacer.mark_shown(now)
        if skip:
            t = time.ticks_us()
            if self._saturated() and self._reader.skip(skip):
                stats["seeked"] += skip
            else:
                for _ in range(skip):
                    dropped = self._reader.next()
                    if dropped is None:
                        break
                    stats["frames_read"] += 1
                    stats["dropped"] += 1
            stats["skip_us"] += time.ticks_diff(time.ticks_us(), t)
        return 1

    def _saturated(self):
        """True when presenting one frame costs more than the clip's period.

        Deliberately excludes the time spent dropping frames: counting that
        here makes the first skip a reason for the next one, and the player
        stays in the slow path even when reading the drops would catch up.
        """
        stats = self._stats
        presented = stats["presented"]
        if presented < 4:
            return False
        return stats["present_us"] * self._fps > 1000000 * presented

    def _stop_pump(self):
        timer = self._pump_timer
        self._pump_timer = None
        if timer is not None:
            try:
                if self._own_pump:
                    timer.deinit()
                else:
                    timer.delete()
            except Exception as e:
                logger.error("media_player: pump stop failed: %s", e)
        self._own_pump = False
        self._give_back_passes()

    def _stop_playback(self):
        was_playing = self._playing
        self._playing = False
        if self._audio_player is None:
            self._paused = False
        self._exit_requested = False
        self._hide_controls()
        self._stop_pump()
        self._close_audio()
        if self._reader is not None:
            self._reader.close()
            self._reader = None
        if was_playing:
            self._report_playback()
        self._play_bufs = None
        self._play_dscs = None
        self._pacer = None
        _hide_widget(self.video_bg)

    def _report_playback(self):
        if self._reported or not self._stats:
            return
        self._reported = True
        stats = self._stats
        elapsed_ms = time.ticks_diff(time.ticks_ms(), self._play_started_ms)
        presented = stats["presented"]
        fps = presented * 1000.0 / elapsed_ms if elapsed_ms else 0.0
        frames = presented or 1
        idle_us = elapsed_ms * 1000 - stats["pass_us"]
        if idle_us < 0:
            idle_us = 0
        other_us = idle_us - stats["audio_us"] - stats["sleep_us"]
        if other_us < 0:
            other_us = 0
        report = (
            "%s @ %dx%d: %d frames in %dms = %.2f fps, %d dropped (%d seek) "
            "of %d read, first frame %dms; read %.1fms skip %.1fms decode "
            "%.1fms set_src %.1fms refr %.1fms lvgl %.1fms pass %.1fms idle "
            "%.1fms (audio %.1f sleep %.1f other %.1f) per frame, %d passes"
        ) % (
            self._play_path + (" (RAM)" if self._preloaded else ""),
            self._play_w, self._play_h,
            presented, elapsed_ms, fps,
            stats["dropped"], stats["seeked"], stats["frames_read"],
            self._first_frame_ms,
            stats["read_us"] / 1000.0 / frames,
            stats["skip_us"] / 1000.0 / frames,
            stats["decode_us"] / 1000.0 / frames,
            stats["set_src_us"] / 1000.0 / frames,
            stats["refr_us"] / 1000.0 / frames,
            stats["lvgl_us"] / 1000.0 / frames,
            stats["pass_us"] / 1000.0 / frames,
            idle_us / 1000.0 / frames,
            stats["audio_us"] / 1000.0 / frames,
            stats["sleep_us"] / 1000.0 / frames,
            other_us / 1000.0 / frames,
            stats["ticks"],
        )
        print("media_player: " + report)
        print("media_player: audio " + self._audio_report())
        if self.status_label is not None and not self._playing:
            try:
                self.status_label.set_text(report)
            except lv.LvReferenceError:
                # The widgets can already be gone when a stop is queued and the
                # activity is torn down first; the on-screen report is only
                # cosmetic, so drop the stale label and keep the printed one.
                self.status_label = None

    def _set_pump_period(self, ms):
        # The own pump keeps a fixed tick and sleeps out the rest; only the
        # LVGL-timer fallback has a period to set.
        if self._own_pump or not self._playing or self._pump_timer is None:
            return
        if ms < 1:
            ms = 1
        elif ms > self.PUMP_MAX_WAIT_MS:
            ms = self.PUMP_MAX_WAIT_MS
        self._pump_timer.set_period(ms)

    def _hide_overlays(self):
        for obj in self._overlays:
            _hide_widget(obj)

    def _show_overlays(self):
        for obj in self._overlays:
            obj.remove_flag(lv.obj.FLAG.HIDDEN)

    # ------------------------------------------------------------------
    #  Benchmark mode (no clip given): draw in-RAM frames as fast as the
    #  panel accepts them.
    # ------------------------------------------------------------------

    def start_benchmark(self, w, h):
        self._stop_timer()
        self._reset_run_state()
        key = (w, h)
        bufs = self._bufs.get(key)
        if bufs is None:
            self.status_label.set_text("preparing %sx%s..." % (w, h))
            print("media_player: preparing %sx%s buffers..." % (w, h))
            bufs = [make_frame_rgb565(w, h, 0), make_frame_rgb565(w, h, 1)]
            self._bufs[key] = bufs
        self._dscs = [self._make_dsc(w, h, bufs[0]), self._make_dsc(w, h, bufs[1])]
        self._apply_scale_once(w, h)
        self.image.set_src(self._dscs[0])
        self._sysmon_samples = []
        self.status_label.set_text("running %sx%s %s frames..." % (w, h, self.N_FRAMES))
        print("media_player: benchmark start %sx%s frames=%s" % (w, h, self.N_FRAMES))
        self._timer = lv.timer_create(self._tick, 1, None)

    def _tick(self, timer):
        now = time.ticks_ms()
        if self._last_ms is not None:
            self._durations.append(time.ticks_diff(now, self._last_ms))
        self._last_ms = now
        t0 = time.ticks_ms()
        self.image.set_src(self._dscs[self._idx])
        self._set_src_ms += time.ticks_diff(time.ticks_ms(), t0)
        self._idx ^= 1
        self._count += 1
        if self._count >= self.N_FRAMES:
            self._finish()

    def _finish(self):
        self._stop_timer()
        stats = compute_stats(self._durations)
        set_src_avg = self._set_src_ms / self._count if self._count else 0
        if self._sysmon_samples:
            sysmon_total = 0
            for s in self._sysmon_samples:
                sysmon_total += s
            sysmon_avg = sysmon_total / len(self._sysmon_samples)
        else:
            sysmon_avg = 0
        report = "%s frames: %.1f FPS avg %.1fms p95 %sms set_src %.2fms sysmon %.1f FPS" % (
            stats["frames"], stats["fps"], stats["avg_ms"], stats["p95_ms"], set_src_avg, sysmon_avg)
        self.status_label.set_text(report)
        print("media_player: " + report)

    def _echo_sysmon(self):
        """Whether the sysmon line should also be echoed to the console.

        The label keeps the latest value either way; only the serial echo is
        time-bounded, because it is what floods a REPL or mpremote session.
        """
        return time.ticks_diff(self._sysmon_log_deadline, time.ticks_ms()) > 0

    def _sysmon_cb(self, level, log_str):
        if self._playing:
            # Updating a label during playback would invalidate and re-flush
            # part of the frame we are measuring.
            return
        if isinstance(log_str, bytes):
            log_str = log_str.decode()
        if "sysmon:" in log_str and "FPS" in log_str:
            try:
                fps = int(log_str.split("FPS")[0].split("sysmon:")[1].strip())
            except (IndexError, ValueError):
                return
            self._sysmon_samples.append(fps)
            if self._echo_sysmon():
                print("media_player sysmon FPS: %s" % fps)
            self.fps_label.set_text("sysmon: %s FPS" % fps)

    def _reset_run_state(self):
        self._count = 0
        self._idx = 0
        self._durations = []
        self._set_src_ms = 0
        self._last_ms = None

    def _stop_timer(self):
        if self._timer is not None:
            self._timer.delete()
            self._timer = None

    def _apply_scale_once(self, w, h):
        disp_w = DisplayMetrics.width() or self.FULL_W
        disp_h = DisplayMetrics.height() or self.FULL_H
        scale = min(disp_w * 256 // w, disp_h * 256 // h)
        self.image.set_size(w * scale // 256, h * scale // 256)
        self.image.set_scale(scale)
        self.image.center()

    @staticmethod
    def _make_dsc(w, h, buf):
        return lv.image_dsc_t({
            "header": {
                "magic": lv.IMAGE_HEADER_MAGIC,
                "w": w,
                "h": h,
                "stride": w * 2,
                "cf": lv.COLOR_FORMAT.RGB565,
            },
            "data_size": len(buf),
            "data": buf,
        })
"""WAV sidecar audio for the video player.

MJPEG has no room for sound, so the player looks for a WAV file next to the
clip (``clip.mjpeg`` -> ``clip.wav``) and streams it against the same wall
clock the frames are paced with. That keeps sound and pictures together
without a second thread: ``AudioManager.player()`` runs a reader thread of its
own, and on this board the SD card is the bottleneck already, so two readers
would take turns costing each other frames.

The pump tops the sink up a fixed number of milliseconds ahead of the video
clock. If the pump stalls for longer than that, audio is skipped forward
instead of drifting: the pictures are the reference, same as dropped frames.

Import-light on purpose (no LVGL, no ``mpos`` at import time) so the parsing
and pacing rules can be unit tested on desktop. See
docs/apps/video-performance.md for the budget these choices come from.
"""

import time

try:
    _ticks_ms = time.ticks_ms
    _ticks_us = time.ticks_us
    _ticks_diff = time.ticks_diff
except AttributeError:  # CPython, for desktop-side tooling only
    def _ticks_ms():
        return int(time.monotonic() * 1000)

    def _ticks_us():
        return int(time.monotonic() * 1000000)

    def _ticks_diff(a, b):
        return a - b


WAVE_FORMAT_PCM = 0x0001
WAVE_FORMAT_IMA_ADPCM = 0x0011
WAVE_FORMAT_EXTENSIBLE = 0xFFFE

# How far ahead of the video clock the sink is kept fed. One frame of picture
# work is 70ms at 320x240 and cannot be interrupted, and on a slow frame the
# pump does not get back to the sound for over 100ms, so the lead has to cover
# a whole frame period plus scheduler jitter. Measured: at 120ms the queue
# still went dry between frames and every underrun was paid for by skipping
# sound forward, and at 250ms a top-up no longer fits the DMA ring in one
# write, which costs the wall time back. 180ms of lead against a 120ms floor
# keeps between two and three frames of sound queued.
AUDIO_LEAD_MS = 180
# Refill whenever the queue drops below this. The ring therefore holds between
# LOW and LEAD ms of sound, and a refill never asks for more than
# LEAD-LOW ms, which is what keeps the write landing in free space instead of
# blocking until the sink has played it.
AUDIO_LOW_MS = 120
# Most source bytes decoded per pump pass, so a refill is spread over ticks
# instead of landing inside one frame's budget.
AUDIO_READ_BYTES = 8192
# A sidecar this small is read into RAM before the first frame: on this board
# one 4KB SD read costs about 10ms, so pulling 44KB/s of PCM a frame at a time
# takes the frame budget below real time (measured 10.9fps at 320x240). In RAM
# the sound costs only the decode and the I2S write.
AUDIO_PRELOAD_BYTES = 512 * 1024
# Bigger sidecars stream through a read-ahead buffer, refilled in one large
# read per ~700ms rather than a small one per frame (same bytes, a third of the
# per-call overhead).
AUDIO_QUEUE_BYTES = 32768
AUDIO_QUEUE_LOW = 8192


def _u16(buf, off=0):
    return buf[off] | (buf[off + 1] << 8)


def _u32(buf, off=0):
    return buf[off] | (buf[off + 1] << 8) | (buf[off + 2] << 16) | (buf[off + 3] << 24)


def _next_pow2(n):
    value = 1024
    while value < n:
        value <<= 1
    return value


def sidecar_path(path, extensions=(".wav", ".WAV")):
    """Return the first audio sidecar that exists next to a video, or None."""
    import os

    name = path.rsplit("/", 1)[-1]
    dot = name.rfind(".")
    base = path[: len(path) - len(name) + dot] if dot > 0 else path
    for ext in extensions:
        candidate = base + ext
        try:
            os.stat(candidate)
        except OSError:
            continue
        return candidate
    return None


def playback_rate(original_rate, preferred_rate=None):
    """Return (sink_rate, upsample_factor).

    Boards with a fixed codec rate ask for one through the output descriptor;
    the player repeats samples rather than resampling, which is what the WAV
    stream in mpos.audio does and costs nothing measurable at these rates.
    """
    if original_rate <= 0:
        return original_rate, 1
    if preferred_rate and preferred_rate > original_rate:
        factor = (preferred_rate + original_rate - 1) // original_rate
        return original_rate * factor, factor
    if original_rate < 8000:
        factor = (8000 + original_rate - 1) // original_rate
        return original_rate * factor, factor
    return original_rate, 1


def _upsample(data, factor):
    """Repeat every 16-bit sample ``factor`` times."""
    if factor <= 1:
        return data
    out = bytearray()
    for i in range(0, len(data), 2):
        sample = data[i:i + 2]
        for _ in range(factor):
            out.extend(sample)
    return out


def _to_s16(raw, bits):
    """Convert 8/16/24/32-bit PCM to 16-bit little endian."""
    if bits == 16:
        return raw
    if bits == 8:
        out = bytearray(len(raw) * 2)
        for i in range(len(raw)):
            value = (raw[i] - 128) << 8
            out[i * 2] = value & 0xFF
            out[i * 2 + 1] = (value >> 8) & 0xFF
        return out
    if bits == 24:
        samples = len(raw) // 3
        out = bytearray(samples * 2)
        j = 0
        for i in range(samples):
            out[i * 2] = raw[j + 1]
            out[i * 2 + 1] = raw[j + 2]
            j += 3
        return out
    if bits == 32:
        samples = len(raw) // 4
        out = bytearray(samples * 2)
        j = 0
        for i in range(samples):
            out[i * 2] = raw[j + 2]
            out[i * 2 + 1] = raw[j + 3]
            j += 4
        return out
    raise ValueError("unsupported bit depth: %s" % bits)


class WavSource:
    """Sequential 16-bit PCM reader over a WAV sidecar.

    Supports PCM (8/16/24/32-bit, mono or stereo) and IMA ADPCM, which are the
    formats the test pairs and ClipTV's sidecars use. Anything else (MS ADPCM,
    MP3) is rejected by the header parse and the player plays on silently.
    """

    def __init__(self, source, preferred_rate=None, preload_bytes=AUDIO_PRELOAD_BYTES):
        if isinstance(source, str):
            self._file = open(source, "rb")
            self.path = source
        else:
            self._file = source
            self.path = getattr(source, "name", "")
        self._format_tag = 0
        self._channels = 0
        self._bits = 0
        self._block_align = 0
        self._data_start = 0
        self._data_size = 0
        self._consumed = 0
        self._samples_per_block = 0
        self._mem = None
        self._mv = None
        self._mem_pos = 0
        self._ima_scratch = None
        self.rate = 0
        self.total_frames = 0
        self._parse()
        self.playback_rate, self.upsample = playback_rate(self.rate, preferred_rate)
        self.byte_rate = self.playback_rate * self._channels * 2
        self.duration_ms = self.total_frames * 1000 // self.rate if self.rate else 0
        self.preload_bytes = preload_bytes

    def preload(self):
        """Read the whole sidecar into RAM if it is small enough."""
        if self.preload_bytes and self._data_size <= self.preload_bytes and self._mem is None:
            return self._preload()
        return False

    def _preload(self):
        """Read the whole data chunk into RAM and release the file."""
        data = self._file.read(self._data_size)
        if not data or len(data) != self._data_size:
            return False
        self._mem = data
        self._mv = memoryview(data)
        self._mem_pos = 0
        try:
            self._file.close()
        except Exception:
            pass
        self._file = None
        return True

    @property
    def in_memory(self):
        return self._mem is not None

    def _read_raw(self, n):
        if self._mem is not None:
            start = self._mem_pos
            end = start + n
            if end > len(self._mem):
                end = len(self._mem)
            if end <= start:
                return b""
            self._mem_pos = end
            return self._mem[start:end]
        return self._file.read(n)

    def _read_raw_into(self, dest, offset, n):
        """Copy up to n source bytes to dest[offset:]; return the count."""
        if self._mem is not None:
            start = self._mem_pos
            end = start + n
            if end > len(self._mem):
                end = len(self._mem)
            if end <= start:
                return 0
            dest[offset:offset + (end - start)] = self._mv[start:end]
            self._mem_pos = end
            return end - start
        raw = self._file.read(n)
        if not raw:
            return 0
        dest[offset:offset + len(raw)] = raw
        return len(raw)

    def _seek_raw(self, offset):
        if self._mem is not None:
            self._mem_pos = offset
            return True
        try:
            self._file.seek(self._data_start + offset)
        except OSError:
            return False
        return True

    # ----- header -------------------------------------------------------

    def _parse(self):
        f = self._file
        f.seek(0)
        head = f.read(12)
        if len(head) < 12 or head[0:4] != b"RIFF" or head[8:12] != b"WAVE":
            raise ValueError("not a WAV file")
        sample_rate = 0
        channels = 0
        bits = 0
        tag = 0
        block_align = 0
        fact_frames = 0
        data_start = -1
        data_size = 0
        pos = 12
        while True:
            f.seek(pos)
            chunk = f.read(8)
            if len(chunk) < 8:
                break
            chunk_id = chunk[0:4]
            chunk_size = _u32(chunk, 4)
            if chunk_id == b"fmt ":
                fmt = f.read(chunk_size)
                if len(fmt) < 16:
                    raise ValueError("short fmt chunk")
                tag = _u16(fmt, 0)
                channels = _u16(fmt, 2)
                sample_rate = _u32(fmt, 4)
                block_align = _u16(fmt, 12)
                bits = _u16(fmt, 14)
                if tag == WAVE_FORMAT_EXTENSIBLE and len(fmt) >= 26:
                    tag = _u16(fmt, 24)
            elif chunk_id == b"fact":
                if chunk_size >= 4:
                    fact_frames = _u32(f.read(4), 0)
            elif chunk_id == b"data":
                data_start = pos + 8
                data_size = chunk_size
            pos += 8 + chunk_size + (chunk_size & 1)
        if data_start < 0:
            raise ValueError("no data chunk")
        if tag not in (WAVE_FORMAT_PCM, WAVE_FORMAT_IMA_ADPCM):
            raise ValueError("unsupported WAV format tag 0x%04x" % tag)
        if channels not in (1, 2):
            raise ValueError("unsupported channel count: %s" % channels)
        if data_size <= 0:
            data_size = self._size() - data_start
        if tag == WAVE_FORMAT_PCM and bits not in (8, 16, 24, 32):
            raise ValueError("unsupported bit depth: %s" % bits)
        if tag == WAVE_FORMAT_IMA_ADPCM:
            if bits not in (4, 16) or block_align <= 0:
                raise ValueError("unsupported IMA ADPCM block")
            self._samples_per_block = 1 + (block_align - 4 * channels) * 2 // channels
            total = (data_size // block_align) * self._samples_per_block
        else:
            frame_bytes = channels * bits // 8
            total = data_size // frame_bytes
        if fact_frames:
            total = fact_frames
        self._format_tag = tag
        self._channels = channels
        self._bits = bits
        self._block_align = block_align
        self._data_start = data_start
        self._data_size = data_size
        self.rate = sample_rate
        self.total_frames = total
        f.seek(data_start)

    def _size(self):
        f = self._file
        position = f.tell()
        end = f.seek(0, 2)
        f.seek(position)
        return end

    # ----- reading ------------------------------------------------------

    @property
    def channels(self):
        return self._channels

    @property
    def format_name(self):
        if self._format_tag == WAVE_FORMAT_IMA_ADPCM:
            return "ima"
        return "pcm%d" % self._bits

    @property
    def remaining_bytes(self):
        return self._data_size - self._consumed

    @property
    def exhausted(self):
        return self.remaining_bytes <= 0

    def read_into(self, dest, offset, max_bytes):
        """Decode up to max_bytes of 16-bit PCM into dest[offset:].

        Returns how many bytes were written; 0 means the stream is over. The
        track feeds this straight into its playback buffer so a refill costs a
        copy rather than a fresh allocation on the PSRAM heap.
        """
        if max_bytes <= 0:
            return 0
        if self._format_tag == WAVE_FORMAT_IMA_ADPCM:
            return self._read_ima_into(dest, offset, max_bytes)
        return self._read_pcm_into(dest, offset, max_bytes)

    def read_pcm(self, max_bytes):
        """Return up to ``max_bytes`` of 16-bit PCM, or None at the end."""
        if max_bytes <= 0:
            return None
        if self._format_tag == WAVE_FORMAT_IMA_ADPCM:
            return self._read_ima(max_bytes)
        frame_bytes = self._channels * self._bits // 8
        want = max_bytes - max_bytes % frame_bytes
        remaining = self.remaining_bytes
        if want > remaining:
            want = remaining - remaining % frame_bytes
        if want <= 0:
            return None
        raw = self._read_raw(want)
        if not raw:
            return None
        self._consumed += len(raw)
        data = _to_s16(raw, self._bits)
        if self.upsample > 1:
            data = _upsample(data, self.upsample)
        return data

    def _read_pcm_into(self, dest, offset, max_bytes):
        frame_bytes = self._channels * self._bits // 8
        want = max_bytes - max_bytes % frame_bytes
        remaining = self.remaining_bytes
        if want > remaining:
            want = remaining - remaining % frame_bytes
        if want <= 0:
            return 0
        if self._bits == 16 and self.upsample == 1:
            n = self._read_raw_into(dest, offset, want)
            self._consumed += n
            return n
        raw = self._read_raw(want)
        if not raw:
            return 0
        self._consumed += len(raw)
        data = _to_s16(raw, self._bits)
        if self.upsample > 1:
            data = _upsample(data, self.upsample)
        n = len(data)
        if n > max_bytes:
            n = max_bytes - max_bytes % (2 * self._channels)
        dest[offset:offset + n] = data[0:n]
        return n

    def _read_ima_into(self, dest, offset, max_bytes):
        from mpos.audio.adpcm_ima import decode_block_into

        block = self._block_align
        per_block = self._samples_per_block * 2 * self._channels
        blocks = max_bytes // per_block
        if blocks <= 0:
            return 0
        remaining = self.remaining_bytes
        if remaining <= 0:
            return 0
        full = remaining // block
        partial = remaining % block
        if blocks > full:
            blocks = full
        written = 0
        if blocks:
            need = blocks * block
            scratch = self._ima_scratch
            if scratch is None or len(scratch) < need:
                scratch = bytearray(need)
                self._ima_scratch = scratch
            got = self._read_raw_into(scratch, 0, need)
            self._consumed += got
            view = memoryview(scratch)
            done = got // block
            for i in range(done):
                decode_block_into(view[i * block:(i + 1) * block], self._channels,
                                  block, dest, offset + i * per_block)
            written = done * per_block
        if partial and blocks >= full:
            # Final short block: pad with zero nibbles (the predictor holds),
            # so the tail is ~90ms of held sample rather than dropped.
            tail = self._read_raw(partial)
            if tail:
                self._consumed += len(tail)
                padded = bytearray(block)
                padded[0:len(tail)] = tail
                decode_block_into(padded, self._channels, block, dest,
                                  offset + written)
                written += per_block
        return written

    def _read_ima(self, max_bytes):
        from mpos.audio.adpcm_ima import decode_block_into

        block = self._block_align
        per_block = self._samples_per_block * 2 * self._channels
        blocks = max_bytes // per_block
        if blocks <= 0:
            blocks = 1
        remaining = self.remaining_bytes
        if remaining <= 0:
            return None
        full = remaining // block
        partial = remaining % block
        if blocks > full:
            blocks = full
        want = blocks + (1 if partial else 0)
        out = bytearray(want * per_block)
        view = memoryview(self._read_raw(blocks * block)) if blocks else b""
        if blocks:
            if not view:
                return None
            self._consumed += len(view)
        for i in range(blocks):
            decode_block_into(view[i * block:(i + 1) * block], self._channels,
                              block, out, i * per_block)
        if partial:
            # Final short block: pad with zero nibbles (the predictor holds),
            # so the tail is ~90ms of held sample rather than dropped.
            tail = self._read_raw(partial)
            if tail:
                self._consumed += len(tail)
                padded = bytearray(block)
                padded[0:len(tail)] = tail
                decode_block_into(padded, self._channels, block, out,
                                  blocks * per_block)
            else:
                out = out[0:blocks * per_block]
        if self.upsample > 1:
            out = _upsample(out, self.upsample)
        return out

    def skip_bytes(self, n):
        """Drop ``n`` bytes of decoded PCM; return how many were dropped."""
        if n <= 0:
            return 0
        if self._format_tag == WAVE_FORMAT_IMA_ADPCM:
            block = self._block_align
            per_block = self._samples_per_block * 2 * self._channels
            blocks = n // per_block
            if blocks <= 0:
                return 0
            target = self._consumed + blocks * block
            if target > self._data_size:
                target = self._data_size
            dropped = ((target - self._consumed) // block) * per_block
            source_bytes = ((target - self._consumed) // block) * block
        else:
            frame_bytes = self._channels * self._bits // 8
            frames = n // (self._channels * 2)
            if frames <= 0:
                return 0
            source_bytes = frames * frame_bytes
            if source_bytes > self.remaining_bytes:
                source_bytes = self.remaining_bytes
                frames = source_bytes // frame_bytes
                source_bytes = frames * frame_bytes
            dropped = frames * self._channels * 2
        if source_bytes <= 0:
            return 0
        if not self._seek_raw(self._consumed + source_bytes):
            return 0
        self._consumed += source_bytes
        return dropped

    def rewind(self):
        if not self._seek_raw(0):
            return False
        self._consumed = 0
        return True

    def close(self):
        if self._file is None:
            self._mem = None
            return
        try:
            self._file.close()
        except Exception:
            pass
        self._mem = None


class AudioClock:
    """Byte budget that keeps the sink a fixed number of ms ahead of the video.

    Treats the audio stream as a queue drained at exactly ``byte_rate`` from
    the moment it started, which is what the I2S peripheral does. Comparing
    that against the bytes handed to the sink tells the player when to refill
    and when the sound has fallen behind the pictures.
    """

    def __init__(self, byte_rate, lead_ms=AUDIO_LEAD_MS, low_ms=AUDIO_LOW_MS,
                 frame_bytes=2):
        self.byte_rate = byte_rate
        self.lead_ms = lead_ms
        self.low_ms = low_ms
        # Every byte count here is rounded down to a whole sample frame. A
        # queue that starts mid-frame plays left and right swapped, and an odd
        # byte count is what once wedged the refill on its last free byte.
        self.frame_bytes = frame_bytes
        self.start_ms = 0
        self.written = 0

    def start(self, now_ms):
        self.start_ms = now_ms
        self.written = 0

    def due_bytes(self, now_ms):
        elapsed = _ticks_diff(now_ms, self.start_ms)
        if elapsed < 0:
            elapsed = 0
        played = elapsed * self.byte_rate // 1000
        return played - played % self.frame_bytes

    def pending_bytes(self, now_ms):
        return self.written - self.due_bytes(now_ms)

    def pending_ms(self, now_ms):
        if self.byte_rate <= 0:
            return 0
        return self.pending_bytes(now_ms) * 1000 // self.byte_rate

    def lead_bytes(self):
        size = self.lead_ms * self.byte_rate // 1000
        return size - size % self.frame_bytes

    def low_bytes(self):
        size = self.low_ms * self.byte_rate // 1000
        return size - size % self.frame_bytes

    def to_write(self, now_ms, max_bytes):
        """How many bytes to hand the sink now (0 while the queue is deep)."""
        pending = self.pending_bytes(now_ms)
        if pending >= self.low_bytes():
            return 0
        want = self.lead_bytes() - pending
        if want > max_bytes:
            want = max_bytes
        return want - want % self.frame_bytes

    def late_bytes(self, now_ms):
        """Bytes the stream is behind the video clock (0 when on time)."""
        behind = self.due_bytes(now_ms) - self.written
        if behind <= 0:
            return 0
        return behind - behind % self.frame_bytes

    def note(self, n):
        self.written += n


class NullSink:
    """Sink for desktop: the clock and the pacing run, nothing is audible."""

    def __init__(self):
        self.written = 0

    def open(self):
        pass

    def wait_ready(self):
        pass

    def write(self, data):
        self.written += len(data)
        return len(data)

    def close(self):
        pass


class I2SSink:
    """I2S TX wired to an ``AudioManager.Output`` descriptor.

    Mirrors what ``mpos.audio.stream_wav.WAVStream`` does before its write
    loop (MCLK PWM -> on_open -> machine.I2S), without the chunking and thread
    that belong to a standalone music player.
    """

    def __init__(self, output, rate, channels, lead_ms=AUDIO_LEAD_MS):
        self.output = output
        self.rate = rate
        self.channels = channels
        self.ibuf = _next_pow2((lead_ms + 50) * rate * channels * 2 // 1000)
        if self.ibuf < 8192:
            self.ibuf = 8192
        self._i2s = None
        self._mck = None
        self.written = 0
        self.opened_ms = 0
        # A new channel queues a full ring of silence, and a write only lands
        # as that silence plays out. Until it has drained, a prime costs its
        # own length in wall time (137ms measured for a 120ms lead) and puts
        # the sound ahead of the picture by exactly that much.
        self.preroll_ms = (self.ibuf * 1000 + rate * channels * 2 - 1) // (rate * channels * 2)

    def open(self):
        import machine

        pins = self.output.i2s_pins
        if pins.get("mck") is not None:
            from machine import PWM, Pin

            self._mck = PWM(Pin(pins["mck"], Pin.OUT))
            self._mck.freq(self.rate * 256)
            self._mck.duty_u16(32768)
        on_open = getattr(self.output, "on_open", None)
        if on_open:
            try:
                on_open()
            except Exception:
                pass
        fmt = machine.I2S.MONO if self.channels == 1 else machine.I2S.STEREO
        kwargs = {"mode": machine.I2S.TX, "bits": 16, "format": fmt,
                  "rate": self.rate, "ibuf": self.ibuf}
        if pins.get("sck") is not None:
            kwargs["sck"] = machine.Pin(pins["sck"], machine.Pin.OUT)
        kwargs["ws"] = machine.Pin(pins["ws"], machine.Pin.OUT)
        kwargs["sd"] = machine.Pin(pins["sd"], machine.Pin.OUT)
        self._i2s = machine.I2S(0, **kwargs)
        self.opened_ms = _ticks_ms()

    def wait_ready(self):
        if self._i2s is None:
            return
        wait = self.preroll_ms - _ticks_diff(_ticks_ms(), self.opened_ms)
        if wait > 0:
            time.sleep_ms(wait)

    def write(self, data):
        written = self._i2s.write(data)
        if written is None:
            written = len(data)
        self.written += written
        return written

    def close(self):
        on_close = getattr(self.output, "on_close", None)
        if on_close:
            try:
                on_close()
            except Exception:
                pass
        try:
            if self._i2s is not None:
                self._i2s.deinit()
        finally:
            self._i2s = None
        try:
            if self._mck is not None:
                self._mck.deinit()
        finally:
            self._mck = None


class AudioTrack:
    """A WAV sidecar played in lockstep with the video clock.

    Decoded PCM goes through a small read-ahead buffer. Preloaded sidecars
    (the common case: 10s of PCM is 441KB) are memcpy only; bigger ones refill
    from the card in one large read, which costs a fraction of what reading a
    few KB per frame did.
    """

    def __init__(self, source, sink, lead_ms=AUDIO_LEAD_MS, low_ms=AUDIO_LOW_MS,
                 queue_bytes=AUDIO_QUEUE_BYTES, queue_low=AUDIO_QUEUE_LOW):
        self.source = source
        self.sink = sink
        self.rate = source.playback_rate
        self.channels = source.channels
        self.preloaded = source.in_memory
        self.clock = AudioClock(source.byte_rate, lead_ms, low_ms, self.channels * 2)
        self.queue_bytes = queue_bytes
        self.queue_low = queue_low
        # One preallocated buffer, consumed from the front and compacted in
        # place. Building a fresh bytearray per refill cost 7ms of PSRAM heap
        # churn per frame and set off GC pauses inside the pump.
        self._buf = bytearray(queue_bytes)
        self._len = 0
        self._pos = 0
        self.started = False
        self.finished = False
        self._source_done = False
        self.start_ms = 0
        self.read_us = 0
        self.write_us = 0
        self.written = 0
        self.skipped = 0
        self.resyncs = 0
        self.underruns = 0
        self.min_pending_ms = 100000

    # ----- read-ahead ---------------------------------------------------

    def buffered_bytes(self):
        return self._len - self._pos

    def _compact(self):
        if self._pos:
            tail = self._len - self._pos
            if tail:
                self._buf[0:tail] = memoryview(self._buf)[self._pos:self._len]
            self._len = tail
            self._pos = 0

    def _drop(self, n):
        """Discard the oldest n bytes of queued PCM; returns how many."""
        available = self.buffered_bytes()
        if available < n:
            n = available
        if n <= 0:
            return 0
        self._pos += n
        if self._pos >= self._len:
            self._pos = 0
            self._len = 0
        return n

    def _take(self, n):
        available = self.buffered_bytes()
        if available <= 0:
            return None
        if n > available:
            n = available
        start = self._pos
        self._pos += n
        if self._pos >= self._len:
            # Drained to the end: reset instead of leaving the cursor level
            # with the write head, which looks like a full ring to _refill.
            self._pos = 0
            self._len = 0
        return memoryview(self._buf)[start:start + n]

    def _refill(self):
        free = self.queue_bytes - self._len
        if free < 16:
            # The ring looks full only because the read cursor moved; compact
            # first. Refusing here turned a single stray byte into a deadlock
            # that never refilled again.
            self._compact()
            free = self.queue_bytes - self._len
            if free < 16:
                return 0
        t = _ticks_us()
        n = self.source.read_into(self._buf, self._len, free)
        if n <= 0 and self._pos and not self.source.exhausted:
            # A decoder with a block granularity cannot use a short tail, and
            # treating that as end of stream silences the rest of the clip.
            self._compact()
            free = self.queue_bytes - self._len
            if free >= 16:
                n = self.source.read_into(self._buf, self._len, free)
        self.read_us += _ticks_diff(_ticks_us(), t)
        if n <= 0:
            self._source_done = self.source.exhausted
            return 0
        self._len += n
        return n

    # ----- playback -----------------------------------------------------

    def ready(self):
        """Wait out the sink's startup silence, with nothing playing yet."""
        if not self.started:
            self.sink.wait_ready()

    def start(self, now_ms):
        # Waiting drained the ring before the first frame was drawn, so the
        # prime below lands in microseconds and sample 0 starts right here.
        self.sink.wait_ready()
        start_ms = _ticks_ms()
        self.clock.start(start_ms)
        self.start_ms = start_ms
        self.started = True
        # Prime the whole lead so the first frames' worth of picture work
        # cannot starve the peripheral.
        self.tick(start_ms, self.clock.lead_bytes())
        return start_ms

    def tick(self, now_ms, max_bytes=AUDIO_READ_BYTES):
        """Keep the sink fed; returns the bytes written this call."""
        if not self.started or self.finished:
            return 0
        if not self._source_done and self.buffered_bytes() < self.queue_low:
            self._refill()
        behind = self.clock.late_bytes(now_ms)
        if behind > 0:
            # The pump stalled longer than the queue: skip the sound forward
            # rather than play the rest of the clip late (dropped frames keep
            # the pictures on time, skipped bytes do the same for audio).
            self.underruns += 1
            dropped = self._drop(behind)
            if dropped < behind:
                dropped += self.source.skip_bytes(behind - dropped)
            if dropped > 0:
                self.resyncs += 1
                self.skipped += dropped
            else:
                dropped = behind
            self.clock.note(dropped)
            if not self._source_done and self.buffered_bytes() < self.queue_low:
                self._refill()
        want = self.clock.to_write(now_ms, max_bytes)
        if want <= 0:
            self._note_queue(now_ms)
            return 0
        data = self._take(want)
        if not data:
            if self._source_done:
                self.finished = True
            return 0
        t = _ticks_us()
        try:
            written = self.sink.write(data)
        except Exception as e:
            self.write_us += _ticks_diff(_ticks_us(), t)
            self.finished = True
            raise e
        self.write_us += _ticks_diff(_ticks_us(), t)
        if written:
            self.clock.note(written)
            self.written += written
        self._note_queue(now_ms)
        return written

    def _note_queue(self, now_ms):
        pending = self.clock.pending_ms(now_ms)
        if pending < self.min_pending_ms:
            self.min_pending_ms = pending

    def stop(self):
        self.finished = True
        try:
            self.sink.close()
        finally:
            self.source.close()
"""AVI (RIFF) demuxer: MJPEG video, optionally with a PCM or IMA audio stream.

The point of AVI is one file that plays everywhere: VLC opens MJPEG-in-AVI with
LPCM out of the box, and so does this player, so the sample clips no longer
need a separate .wav sidecar to carry sound.

Only what a player needs is parsed: the two stream headers, the frame rate, and
the chunk layout of the `movi` list. Every chunk carries its own size, so
dropping a frame is a seek past one header instead of an SOI scan.

OpenDML files (a second `AVIX` riff with a continued `movi` list, only used
above 1 GB) are read up to the end of their first `movi` list.
"""

WAVE_FORMAT_PCM = 1
WAVE_FORMAT_MS_ADPCM = 0x0002
WAVE_FORMAT_IMA_ADPCM = 0x0011
WAVE_FORMAT_MP3 = 0x0055
WAVE_FORMAT_MPEG = 0x0050

_AUDIO_NAMES = {
    0x0003: "IEEE float",
    0x0006: "A-law",
    0x0007: "mu-law",
    0x0050: "MPEG audio",
    0x0055: "MP3",
    0x00FF: "AAC",
    0x2000: "AC-3",
}

_VIDEO_CODECS = (b"MJPG", b"JPEG")

# How much sound the demuxer may run ahead of the pictures. The audio track
# asks for a lead of ~180ms, so this holds several times that and leaves room
# for a stalled pump without dropping sound.
AUDIO_FEED_BYTES = 96 * 1024
# Frames the demuxer keeps read ahead of the one being presented. The sound
# that goes with them is what the audio track's lead is built from: without a
# lookahead the interleave ties sound to pictures one-to-one, so priming the
# sink would eat the whole queue and every slow frame would starve the sound.
# Six frames keep ~400ms of sound in hand, of which the prime takes 180ms.
LOOKAHEAD_FRAMES = 6


class _Feed:
    """Fixed byte ring: the demuxer writes, the audio track drains."""

    def __init__(self, size):
        self.buf = bytearray(size)
        self.len = 0
        self.pos = 0

    def buffered(self):
        return self.len - self.pos

    def reset(self):
        self.len = 0
        self.pos = 0

    def append(self, data):
        size = len(data)
        if size > len(self.buf) - self.len:
            self._compact()
            if size > len(self.buf) - self.len:
                return 0
        self.buf[self.len:self.len + size] = data
        self.len += size
        return size

    def take(self, dest, offset, count):
        available = self.buffered()
        if count > available:
            count = available
        if count <= 0:
            return 0
        dest[offset:offset + count] = memoryview(self.buf)[self.pos:self.pos + count]
        self.pos += count
        if self.pos >= self.len:
            self.pos = 0
            self.len = 0
        elif self.pos >= len(self.buf) // 2:
            self._compact()
        return count

    def drop(self, count):
        available = self.buffered()
        if count > available:
            count = available
        if count <= 0:
            return 0
        self.pos += count
        if self.pos >= self.len:
            self.pos = 0
            self.len = 0
        return count

    def _compact(self):
        tail = self.len - self.pos
        if tail:
            self.buf[0:tail] = memoryview(self.buf)[self.pos:self.len]
        self.len = tail
        self.pos = 0


class UnsupportedFormat(Exception):
    """A container or codec this player cannot play, with a readable reason."""

    def __init__(self, message):
        super().__init__(message)
        self.message = message


def _u16(buf, at):
    return buf[at] | (buf[at + 1] << 8)


def _u32(buf, at):
    return (buf[at] | (buf[at + 1] << 8) | (buf[at + 2] << 16)
            | (buf[at + 3] << 24))


def _fourcc_name(codec):
    try:
        name = bytes(codec).decode()
    except Exception:
        return "unknown"
    name = name.strip("\x00 ").strip()
    return name or "unknown"


def codec_name(tag):
    """Readable name for a WAVE format tag."""
    return _AUDIO_NAMES.get(tag, "%#06x" % tag)


class AviReader:
    """Demux an AVI file into MJPEG frames plus optional audio.

    ``next()`` returns one video payload as a memoryview into an internal
    buffer, valid until the next call, exactly like ``MjpegReader``.
    ``audio_source()`` returns the matching ``AviAudioSource`` or raises
    ``UnsupportedFormat`` when the audio codec is one this player cannot play.
    """

    def __init__(self, source):
        self._file = open(source, "rb") if isinstance(source, str) else source
        self._path = source if isinstance(source, str) else None
        self._buf = bytearray(0)
        self._pos = 0
        self.frames = 0
        self.sum_frame_bytes = 0
        self.skipped = 0
        self.error = None
        self.width = 0
        self.height = 0
        self.fps = None
        self.frame_count = 0
        self.microsec_per_frame = 0
        self.movi_start = 0
        self.movi_end = 0
        self.video_id = b"00dc"
        self._audio_id = b"01wb"
        self.video_codec = b""
        self.video_found = False
        self.audio = None
        self.feed = None
        self.audio_lost = 0
        self._pending = []
        self._streams = 0
        self._parse()
        self._pos = self.movi_start

    # ----- parsing ------------------------------------------------------

    def _read_at(self, offset, count):
        self._file.seek(offset)
        return self._file.read(count)

    def _parse(self):
        size = self._file.seek(0, 2)
        head = self._read_at(0, 12)
        if len(head) < 12 or head[0:4] != b"RIFF" or head[8:12] != b"AVI ":
            if len(head) >= 12 and head[0:4] == b"RIFF" and head[8:12] == b"AMV ":
                raise UnsupportedFormat(
                    "AMV files are not supported (convert to MJPEG AVI first)")
            raise UnsupportedFormat(
                "not an AVI file (only AVI with MJPEG video is supported)")
        pos = 12
        while pos + 8 <= size:
            chunk = self._read_at(pos, 12)
            if len(chunk) < 8:
                break
            chunk_id = chunk[0:4]
            chunk_size = _u32(chunk, 4)
            data = pos + 8
            if chunk_id == b"LIST" and len(chunk) >= 12:
                kind = chunk[8:12]
                if kind == b"hdrl":
                    self._parse_hdrl(data + 4, data + chunk_size)
                elif kind == b"movi":
                    self.movi_start = data + 4
                    self.movi_end = data + chunk_size
                    break
            pos = data + chunk_size + (chunk_size & 1)
        if self.audio:
            self._audio_id = self.audio["id"]
        if not self.movi_start or not self.video_found:
            raise UnsupportedFormat(
                "no video stream in this AVI (only MJPEG video is supported)")
        if self.video_codec and self.video_codec.upper() not in _VIDEO_CODECS:
            raise UnsupportedFormat(
                "unsupported video codec: %s (this player plays MJPEG)"
                % _fourcc_name(self.video_codec))
        if not self.fps:
            if self.microsec_per_frame:
                self.fps = 1000000 // self.microsec_per_frame
            else:
                self.fps = 15

    def _parse_hdrl(self, start, end):
        pos = start
        while pos + 8 <= end:
            chunk = self._read_at(pos, 12)
            if len(chunk) < 8:
                return
            chunk_id = chunk[0:4]
            chunk_size = _u32(chunk, 4)
            data = pos + 8
            if chunk_id == b"avih":
                header = self._read_at(data, min(chunk_size, 40))
                if len(header) >= 40:
                    self.microsec_per_frame = _u32(header, 0)
                    self.frame_count = _u32(header, 16)
                    self.width = _u32(header, 32)
                    self.height = _u32(header, 36)
            elif chunk_id == b"LIST" and len(chunk) >= 12:
                if chunk[8:12] == b"strl":
                    self._parse_strl(data + 4, data + chunk_size)
            pos = data + chunk_size + (chunk_size & 1)

    def _parse_strl(self, start, end):
        index = self._streams
        self._streams += 1
        stream_type = None
        scale = 0
        rate = 0
        length = 0
        fmt = b""
        pos = start
        while pos + 8 <= end:
            chunk = self._read_at(pos, 8)
            if len(chunk) < 8:
                break
            chunk_id = chunk[0:4]
            chunk_size = _u32(chunk, 4)
            data = pos + 8
            if chunk_id == b"strh":
                header = self._read_at(data, min(chunk_size, 48))
                if len(header) >= 36:
                    stream_type = header[0:4]
                    scale = _u32(header, 20)
                    rate = _u32(header, 24)
                    length = _u32(header, 32)
            elif chunk_id == b"strf":
                fmt = self._read_at(data, min(chunk_size, 64))
            pos = data + chunk_size + (chunk_size & 1)
        if stream_type == b"vids":
            self.video_found = True
            self.video_id = ("%02d" % index).encode() + b"dc"
            if len(fmt) >= 20:
                self.video_codec = fmt[16:20]
            if scale and rate:
                self.fps = int((rate + scale // 2) // scale)
            if length:
                self.frame_count = length
        elif stream_type == b"auds" and self.audio is None:
            self.audio = self._audio_info(index, fmt, length)

    @staticmethod
    def _audio_info(index, fmt, length):
        info = {
            "id": ("%02d" % index).encode() + b"wb",
            "tag": 0,
            "channels": 1,
            "rate": 0,
            "bits": 16,
            "block_align": 0,
            "samples_per_block": 0,
            "bytes": 0,
        }

        def fill(buf, at):
            if len(buf) < at + 2:
                return 0
            return _u16(buf, at)

        def fill32(buf, at):
            if len(buf) < at + 4:
                return 0
            return _u32(buf, at)

        info["tag"] = fill(fmt, 0)
        info["channels"] = fill(fmt, 2) or 1
        info["rate"] = fill32(fmt, 4)
        info["block_align"] = fill(fmt, 12)
        info["bits"] = fill(fmt, 14)
        extra = fill(fmt, 16)
        if extra >= 2:
            info["samples_per_block"] = fill(fmt, 18)
        if length and info["block_align"]:
            info["bytes"] = length * info["block_align"]
        return info

    # ----- chunk stepping -----------------------------------------------

    def _step(self):
        """Read the next chunk header; return (id, size, data_pos) or None.

        Leaves the cursor after the chunk (header included) and does not touch
        the payload, so the caller decides whether to read it.
        """
        if self._pos >= self.movi_end:
            return None
        self._file.seek(self._pos)
        header = self._file.read(8)
        if len(header) < 8:
            self._pos = self.movi_end
            return None
        chunk_id = header[0:4]
        chunk_size = _u32(header, 4)
        data = self._pos + 8
        self._pos = data + chunk_size + (chunk_size & 1)
        return chunk_id, chunk_size, data

    def _read_audio(self, size, data):
        """Copy an audio chunk into the feed; False when it does not fit."""
        if self.feed is None or size <= 0:
            return True
        feed = self.feed
        if size > len(feed.buf) - feed.len:
            feed._compact()
        if size > len(feed.buf) - feed.len:
            # The pump is behind: drop the queued sound rather than stall the
            # pictures, exactly like the audio track's own resync.
            feed.drop(feed.buffered())
            self.audio_lost += size
            return False
        self._file.seek(data)
        got = self._file.readinto(memoryview(feed.buf)[feed.len:feed.len + size])
        if got != size:
            return False
        feed.len += size
        return True

    def _read_frame(self, size, data):
        buf = self._buf
        if size > len(buf):
            buf = bytearray(size)
            self._buf = buf
        self._file.seek(data)
        got = self._file.readinto(memoryview(buf)[:size])
        if got != size:
            self.error = "short frame read"
            return None
        self.frames += 1
        self.sum_frame_bytes += size
        return memoryview(buf)[:size]

    # ----- video --------------------------------------------------------

    def _advance(self, sound=True):
        """Walk one chunk: queue a frame, or feed its sound. False at the end."""
        chunk = self._step()
        if chunk is None:
            return False
        chunk_id, chunk_size, data = chunk
        if chunk_id == self.video_id and chunk_size > 0:
            self._pending.append((chunk_size, data))
        elif self.feed is not None and chunk_id == self._audio_id and sound:
            self._read_audio(chunk_size, data)
        return True

    def _top_up(self):
        while len(self._pending) < LOOKAHEAD_FRAMES:
            if not self._advance():
                return

    def next(self):
        self._top_up()
        if not self._pending:
            return None
        size, data = self._pending.pop(0)
        return self._read_frame(size, data)

    def skip(self, n, sound=True):
        """Drop n queued or upcoming frames without reading their payloads.

        With sound=True the sound that belongs to them still flows, so a drop
        keeps the pictures and the sound on the same clock. A seek passes
        sound=False: it wants the sound to jump too, not to play what it
        skipped over.
        """
        dropped = 0
        while dropped < n:
            if self._pending:
                self._pending.pop(0)
                dropped += 1
                continue
            if not self._advance(sound):
                break
        self.skipped += dropped
        self._top_up()
        return dropped == n

    def prefill_audio(self, ms):
        """Run the demuxer ahead until it has ``ms`` of sound queued.

        The frames walked on the way stay queued, in order, so nothing is
        skipped; their sound is what the sink is primed with.
        """
        if self.feed is None or not self.audio or not self.audio["rate"]:
            return 0
        want = self.audio["rate"] * self.audio["channels"] * 2 * ms // 1000
        if self.audio["tag"] == WAVE_FORMAT_IMA_ADPCM:
            per_block = self._ima_per_block()
            if per_block:
                want = (want + per_block - 1) // per_block * self._ima_payload()
        while self.feed.buffered() < want:
            if not self._advance():
                break
        return self.feed.buffered()

    def _ima_payload(self):
        return self.audio["block_align"] if self.audio else 0

    def _ima_per_block(self):
        if not self.audio:
            return 0
        channels = self.audio["channels"]
        samples = self.audio["samples_per_block"]
        if not samples:
            samples = 1 + (self.audio["block_align"] - 4 * channels) * 2 // channels
        return samples * 2 * channels

    def at_end(self):
        return self._pos >= self.movi_end and not self._pending

    def audio_at_end(self):
        """True when the demuxer has walked the file and the feed is drained."""
        return self._pos >= self.movi_end and self.feed is not None and self.feed.buffered() == 0

    def rewind(self):
        self._pos = self.movi_start
        self._pending = []
        if self.feed is not None:
            self.feed.reset()
        return True

    def close(self):
        try:
            self._file.close()
        except Exception:
            pass

    # ----- audio --------------------------------------------------------

    def audio_source(self):
        if self.audio is None:
            return None
        source = AviAudioSource(self, self.audio)
        self.feed = _Feed(AUDIO_FEED_BYTES)
        self.audio_lost = 0
        return source


class AviAudioSource:
    """Decoded PCM from the audio stream the demuxer is carrying.

    Presents the same surface as ``WavSource``: ``read_into`` fills a buffer
    with 16-bit PCM, so the player's audio track does not care where the sound
    came from. The bytes arrive as a side effect of reading the pictures: the
    demuxer walks the interleaved chunks in order, so the sound costs no seek
    and no second pass over the file.
    """

    def __init__(self, reader, info):
        tag = info["tag"]
        if tag == WAVE_FORMAT_PCM:
            if info["bits"] not in (8, 16):
                raise UnsupportedFormat(
                    "unsupported audio: %d-bit PCM (this player plays 8/16-bit "
                    "or IMA ADPCM)" % info["bits"])
            self.format_name = "pcm16" if info["bits"] == 16 else "pcm8"
            self._ima = False
        elif tag == WAVE_FORMAT_IMA_ADPCM:
            if info["block_align"] <= 0 or info["channels"] < 1:
                raise UnsupportedFormat(
                    "unsupported audio: broken IMA ADPCM header")
            self.format_name = "ima"
            self._ima = True
        else:
            raise UnsupportedFormat(
                "unsupported audio codec: %s (this player plays 8/16-bit PCM "
                "or IMA ADPCM)" % codec_name(tag))
        if not info["rate"]:
            raise UnsupportedFormat("unsupported audio: no sample rate in the AVI")
        self._reader = reader
        self._bits = info["bits"]
        self.channels = info["channels"]
        self.playback_rate = info["rate"]
        self.upsample = 1
        self.byte_rate = self.playback_rate * self.channels * 2
        self._block_align = info["block_align"]
        self._samples_per_block = info["samples_per_block"]
        if self._ima and not self._samples_per_block:
            self._samples_per_block = 1 + (self._block_align - 4 * self.channels) * 2 // self.channels
        self._block = bytearray(self._block_align) if self._ima else None
        self._widen = bytearray(1024) if (not self._ima and self._bits == 8) else None
        total = info["bytes"]
        self.total_frames = total // (self.channels * 2) if total else 0

    # The audio track asks for this interface.
    @property
    def in_memory(self):
        return False

    @property
    def remaining_bytes(self):
        return 0 if self.exhausted else 1 << 30

    @property
    def exhausted(self):
        return self._reader.audio_at_end()

    def preload(self):
        return False

    def read_into(self, dest, offset, max_bytes):
        if max_bytes <= 0:
            return 0
        feed = self._reader.feed
        if not self._ima:
            if self._bits == 16:
                return feed.take(dest, offset, max_bytes)
            return self._take_pcm8(dest, offset, max_bytes)
        from mpos.audio.adpcm_ima import decode_block_into

        per_block = self._samples_per_block * 2 * self.channels
        if per_block <= 0:
            return 0
        written = 0
        while max_bytes - written >= per_block:
            if not self._fill_block():
                break
            decode_block_into(memoryview(self._block), self.channels,
                              self._block_align, dest, offset + written)
            written += per_block
        return written

    def _take_pcm8(self, dest, offset, max_bytes):
        """Widen unsigned 8-bit samples to signed 16-bit, centred on zero."""
        feed = self._reader.feed
        scratch = self._widen
        out = offset
        written = 0
        while max_bytes - written >= 2:
            count = len(scratch)
            if count > (max_bytes - written) // 2:
                count = (max_bytes - written) // 2
            got = feed.take(scratch, 0, count)
            if got <= 0:
                break
            for i in range(got):
                sample = (scratch[i] - 128) << 8
                dest[out] = sample & 0xFF
                dest[out + 1] = (sample >> 8) & 0xFF
                out += 2
            written += got * 2
        return written

    def _fill_block(self):
        feed = self._reader.feed
        need = self._block_align
        got = 0
        while got < need:
            if feed.buffered() <= 0:
                return False
            take = feed.buffered()
            if take > need - got:
                take = need - got
            got += feed.take(self._block, got, take)
        return True

    def skip_bytes(self, n):
        """Drop n bytes of decoded PCM; return how many were dropped.

        A skip only has to move the feed's read cursor: the demuxer keeps
        pulling the same bytes off the card either way, so nothing is re-read.
        """
        if n <= 0:
            return 0
        feed = self._reader.feed
        if self._ima:
            per_block = self._samples_per_block * 2 * self.channels
            if per_block <= 0 or not self._block_align:
                return 0
            blocks = n // per_block
            dropped = feed.drop(blocks * self._block_align)
            return (dropped // self._block_align) * per_block
        if self._bits == 8:
            return feed.drop(n // 2) * 2
        return feed.drop(n)

    def close(self):
        pass
"""MJPEG frame reader and frame pacer for the video player.

Deliberately free of LVGL imports so it can be unit tested on desktop and
reused by other players. See docs/apps/video-performance.md for the cost model
these choices come from.
"""

import time

try:
    _ticks_diff = time.ticks_diff
except AttributeError:  # CPython, for desktop-side tooling only
    def _ticks_diff(a, b):
        return a - b

SOI = b"\xff\xd8"
EOI = b"\xff\xd9"

_SOF_MARKERS = (0xC0, 0xC1, 0xC2, 0xC3)

# A seek costs about 15ms on this SD card, and the read that finds the next
# SOI after it pulls in about one frame, so dropping a single frame is cheaper
# to read than to seek.
MIN_SEEK_FRAMES = 2


class MemoryFile:
    """Read-only file object over a clip held in RAM.

    The demuxers do seek/read/readinto, so a clip that fits in PSRAM is read
    once and then played from memory: the SD card is out of the per-frame path
    and a loop or a seek costs nothing. ``read`` returns bytes (a small copy)
    because the demuxer compares chunk ids against literals; the hot paths use
    ``readinto`` and copy nothing.
    """

    def __init__(self, data):
        self._data = data
        self._pos = 0
        self._size = len(data)

    def seek(self, offset, whence=0):
        if whence == 0:
            self._pos = offset
        elif whence == 1:
            self._pos += offset
        else:
            self._pos = self._size + offset
        if self._pos < 0:
            self._pos = 0
        elif self._pos > self._size:
            self._pos = self._size
        return self._pos

    def tell(self):
        return self._pos

    def read(self, count=-1):
        if count is None or count < 0:
            count = self._size - self._pos
        end = self._pos + count
        if end > self._size:
            end = self._size
        chunk = bytes(memoryview(self._data)[self._pos:end])
        self._pos = end
        return chunk

    def readinto(self, target):
        want = len(target)
        end = self._pos + want
        if end > self._size:
            end = self._size
        count = end - self._pos
        if count <= 0:
            return 0
        target[0:count] = memoryview(self._data)[self._pos:end]
        self._pos = end
        return count

    def close(self):
        pass


class MjpegReader:
    """Split a raw MJPEG stream into complete JPEG frames.

    Slides a small buffer over the file and returns a memoryview into it, so
    reading a frame does not copy it. The view stays valid until the next
    call to next().
    """

    def __init__(self, source, chunk=32768, cap=65536):
        if isinstance(source, str):
            self._file = open(source, "rb")
        else:
            self._file = source
        self._buf = bytearray(cap)
        self._chunk = chunk
        self._len = 0
        self._pos = 0
        self._eof = False
        self._chunk_next = 0
        self.bytes_read = 0
        self.frames = 0
        self.sum_frame_bytes = 0
        self.skipped = 0
        self.error = None
        self._seekable = True
        self._size = 0
        try:
            position = self._file.tell()
            self._size = self._file.seek(0, 2)
            self._file.seek(position)
        except OSError:
            self._seekable = False

    def _fill(self):
        # Compact first so the free space is contiguous at the end.
        if self._pos:
            remaining = self._len - self._pos
            if remaining:
                self._buf[0:remaining] = self._buf[self._pos:self._len]
            self._len = remaining
            self._pos = 0
        if self._eof:
            return False
        room = len(self._buf) - self._len
        if room <= 0:
            return False
        want = self._chunk_next or self._chunk
        self._chunk_next = 0
        if want > room:
            want = room
        n = self._file.readinto(memoryview(self._buf)[self._len:self._len + want])
        if not n:
            self._eof = True
            return False
        self._len += n
        self.bytes_read += n
        return True

    def next(self):
        while True:
            start = self._buf.find(SOI, self._pos, self._len)
            if start < 0:
                # Keep the final byte: it may be the 0xff of a split SOI.
                self._pos = self._len - 1 if self._len else 0
                if not self._fill():
                    return None
                continue
            end = self._buf.find(EOI, start + 2, self._len)
            if end < 0:
                if start == 0 and self._len >= len(self._buf):
                    # A single frame larger than the buffer: drop this SOI and
                    # resync on the next one.
                    self.error = "frame exceeds buffer"
                    self._pos = 2
                    continue
                self._pos = start
                if not self._fill():
                    return None
                continue
            self._pos = end + 2
            self.frames += 1
            self.sum_frame_bytes += end + 2 - start
            return memoryview(self._buf)[start:end + 2]

    def skip(self, n):
        """Advance past the next n frames without reading their bytes.

        Reading a dropped frame costs its bytes at SD speed. On a 320x240 30fps
        stream every frame is 23KB and the card delivers about 550KB/s, so
        reading the frames that are dropped instead of presenting them is the
        whole budget (see docs/apps/video-performance.md).

        The seek is only worth it once it avoids more bytes than the resync
        read costs, which is why n has a floor.

        Returns True when the skip happened, False when the caller has to read
        and discard instead.
        """
        if (not self._seekable or n < MIN_SEEK_FRAMES or not self.frames
                or self._size <= 0):
            return False
        average = self.sum_frame_bytes // self.frames
        if average <= 0:
            return False
        stream_pos = self._file.tell() - (self._len - self._pos)
        target = stream_pos + n * average
        if target >= self._size:
            target = self._size - 1
        if target <= stream_pos:
            return False
        try:
            self._file.seek(target)
        except OSError:
            self._seekable = False
            return False
        self._len = 0
        self._pos = 0
        self._eof = False
        self.skipped += n
        # Find the next SOI with one frame worth of read instead of a full
        # chunk, which would pull in frames nobody asked for.
        self._chunk_next = average
        return True

    def rewind(self):
        try:
            self._file.seek(0)
        except OSError:
            return False
        self._len = 0
        self._pos = 0
        self._eof = False
        return True

    def close(self):
        try:
            self._file.close()
        except Exception:
            pass


_SIGNATURES = (
    (b"ftyp", 4, "an MP4/MOV file"),
    (b"\x1aE\xdf\xa3", 0, "a Matroska/WebM file"),
    (b"OggS", 0, "an Ogg file"),
    (b"FLV\x01", 0, "a Flash video file"),
    (b"GIF8", 0, "a GIF image"),
    (b"RIFF", 0, "a RIFF file (AVI or WAV)"),
    (b"\xff\xd8", 0, "a JPEG image or MJPEG stream"),
)


def sniff_format(source, size=16):
    """Name the container from its first bytes, for a readable error.

    "no frames in foo.mjpeg" is true but useless when the file is really an
    MP4 with the wrong extension. Returns a printable description or None.
    """
    try:
        if isinstance(source, str):
            handle = open(source, "rb")
            try:
                head = handle.read(size)
            finally:
                handle.close()
        else:
            # Sniff the start of the stream, then put the cursor back where it
            # was: the caller may already be positioned for its own parsing.
            try:
                position = source.tell()
                source.seek(0)
            except (OSError, AttributeError):
                position = None
            head = source.read(size)
            if position is not None:
                try:
                    source.seek(position)
                except OSError:
                    pass
    except OSError:
        return None
    if not head:
        return None
    for signature, offset, name in _SIGNATURES:
        at = offset
        if len(head) >= at + len(signature) and head[at:at + len(signature)] == signature:
            return name
    if head[0:3] == b"ID3" or (len(head) > 1 and head[0] == 0xFF and (head[1] & 0xE0) == 0xE0):
        return "an MP3 stream"
    return None


def jpeg_dimensions(frame):
    """Return (width, height) from a JPEG's start-of-frame marker, or (None, None)."""
    i = 2
    n = len(frame)
    while i + 9 < n:
        if frame[i] != 0xFF:
            i += 1
            continue
        marker = frame[i + 1]
        if marker in _SOF_MARKERS:
            height = (frame[i + 5] << 8) | frame[i + 6]
            width = (frame[i + 7] << 8) | frame[i + 8]
            return width, height
        if marker == 0xD8 or marker == 0xD9 or 0xD0 <= marker <= 0xD7:
            i += 2
            continue
        if i + 3 >= n:
            break
        segment = (frame[i + 2] << 8) | frame[i + 3]
        i += 2 + segment
    return None, None


def fps_from_name(path):
    """Get the frame rate from a name like ruler_320x240_15fps.mjpeg.

    MJPEG has no container, so the rate is not in the stream. The naming
    convention is the only source; callers can also pass an explicit "fps".
    """
    name = path.rsplit("/", 1)[-1].lower()
    end = name.find("fps")
    if end <= 0:
        return None
    start = end
    while start > 0 and name[start - 1].isdigit():
        start -= 1
    if start == end:
        return None
    try:
        value = int(name[start:end])
    except ValueError:
        return None
    return value if 1 <= value <= 120 else None


class Pacer:
    """Frame clock for playback.

    Frames are due at start + n * 1000 / fps. When a frame is shown late, the
    pacer reports how many whole intervals were missed so the player can drop
    them and keep wall-clock time.
    """

    def __init__(self, fps, now_ms, drop=True):
        self.fps = fps if fps and fps > 0 else 15
        self.start_ms = now_ms
        self.frame = 0
        self.drop = drop

    def due_ms(self):
        return self.start_ms + self.frame * 1000 // self.fps

    def wait_ms(self, now_ms):
        return _ticks_diff(self.due_ms(), now_ms)

    def mark_shown(self, now_ms):
        """Advance past the frame just presented; return how many to skip."""
        self.frame += 1
        if not self.drop:
            return 0
        late = _ticks_diff(now_ms, self.due_ms())
        if late <= 0:
            return 0
        skip = late * self.fps // 1000
        self.frame += skip
        return skip

    def reset(self, now_ms):
        self.start_ms = now_ms
        self.frame = 0
