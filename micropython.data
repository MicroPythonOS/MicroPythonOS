LCD_SPI_FREQ = const(40000000)
LCD_SCLK = const(18)
LCD_MOSI = const(23)
LCD_MISO = const(12)
LCD_DC = const(32)
LCD_CS = const(27)
LCD_BL = const(4)
LCD_RST = const(5)
LCD_TYPE = const(1)

