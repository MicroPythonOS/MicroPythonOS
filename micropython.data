    """Watchdog config values"""
    # Just interrupt to pin
    XPOWERS_AXP2101_WDT_IRQ_TO_PIN = const(0)
    # IRQ to pin and reset pmu system
    XPOWERS_AXP2101_WDT_IRQ_AND_RSET = const(1)
