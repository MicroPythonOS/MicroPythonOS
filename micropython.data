        #quality = prefs.get_int("quality", 85)
        #slider, label, cont = self.create_slider(tab, "JPEG Quality", 0, 100, quality, "quality")
        #self.ui_controls["quality"] = slider

        # Color Bar
        colorbar = prefs.get_bool("colorbar")
