        val = super().readRegister(_AXP2101_FAST_PWRON_SET2)[0]
        super().writeRegister(_AXP2101_FAST_PWRON_SET2, val | ((opt & 0x3) << 2))

    def setAldo4FastStartSequence(self, opt: int) -> None:
        val = super().readRegister(_AXP2101_FAST_PWRON_SET2)[0]
