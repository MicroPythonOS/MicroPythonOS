+// littlefs2e: give the lfs2e user C module the filesystem mounted at "/".
+// There is no public Python accessor for the mounted VfsLfs2 instance, and
+// the extent API needs the lfs2_t (not just a path).
+lfs2_t *mp_vfs_lfs2_root_lfs2(void) {
+    for (mp_vfs_mount_t *vfs = MP_STATE_VM(vfs_mount_table);
+            vfs != NULL; vfs = vfs->next) {
+        if (vfs->len == 1 && vfs->str[0] == '/') {
+            if (mp_obj_is_type(vfs->obj, &mp_type_vfs_lfs2)) {
+                return &((mp_obj_vfs_lfs2_t *)MP_OBJ_TO_PTR(vfs->obj))->lfs;
+            }
+            return NULL;
+        }
+    }
+    return NULL;
+}
