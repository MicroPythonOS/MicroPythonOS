 // Public API
 #ifndef LFS2_READONLY
+
+/// littlefs2e extent files ///
+
+struct lfs2_ext_map {
+    uint8_t *map;
+    lfs2_size_t size;
+};
+
+static int lfs2_ext_map_cb(void *data, lfs2_block_t block) {
+    struct lfs2_ext_map *m = data;
+    if (block / 8 < m->size) {
+        m->map[block / 8] |= (uint8_t)(1U << (block % 8));
+    }
+    return 0;
+}
+
+static lfs2_size_t lfs2_ext_map_size(lfs2_t *lfs2) {
+    return (lfs2->block_count + 7) / 8;
+}
+
+static bool lfs2_ext_map_get(const uint8_t *map, lfs2_block_t block) {
+    return (map[block / 8] & (uint8_t)(1U << (block % 8))) != 0;
+}
+
+static void lfs2_ext_map_set(uint8_t *map, lfs2_block_t block) {
+    map[block / 8] |= (uint8_t)(1U << (block % 8));
+}
+
+// Mark this directory's metadata pair and every pair in its tail chain.
+static void lfs2_ext_mark_pairs(lfs2_t *lfs2, const lfs2_block_t pair[2],
+        uint8_t *meta, lfs2_size_t meta_size) {
+    lfs2_block_t p[2] = {pair[0], pair[1]};
+    int guard = 0;
+    while (!lfs2_pair_isnull(p) && guard++ < 128) {
+        if (p[0] / 8 < meta_size) {
+            lfs2_ext_map_set(meta, p[0]);
+        }
+        if (p[1] / 8 < meta_size) {
+            lfs2_ext_map_set(meta, p[1]);
+        }
+        lfs2_mdir_t m;
+        if (lfs2_dir_fetch(lfs2, &m, p)) {
+            break;
+        }
+        p[0] = m.tail[0];
+        p[1] = m.tail[1];
+    }
+}
+
+static int lfs2_ext_walk_meta(lfs2_t *lfs2, const char *path, int depth,
+        uint8_t *meta, lfs2_size_t meta_size) {
+    if (depth > 8) {
+        return LFS2_ERR_INVAL;
+    }
+
+    lfs2_dir_t dir;
+    int err = lfs2_dir_open(lfs2, &dir, path);
+    if (err) {
+        return err;
+    }
+    lfs2_ext_mark_pairs(lfs2, dir.m.pair, meta, meta_size);
+
+    struct lfs2_info info;
+    while ((err = lfs2_dir_read(lfs2, &dir, &info)) > 0) {
+        if (info.type != LFS2_TYPE_DIR) {
+            continue;
+        }
+        if (strcmp(info.name, ".") == 0 || strcmp(info.name, "..") == 0) {
+            continue;
+        }
+        char child[LFS2_NAME_MAX+2];
+        lfs2_size_t plen = strlen(path);
+        lfs2_size_t nlen = strlen(info.name);
+        bool slash = strcmp(path, "/") != 0;
+        if (plen + (slash ? 1 : 0) + nlen + 1 > sizeof(child)) {
+            lfs2_dir_close(lfs2, &dir);
+            return LFS2_ERR_NAMETOOLONG;
+        }
+        memcpy(child, path, plen);
+        lfs2_size_t o = plen;
+        if (slash) {
+            child[o++] = '/';
+        }
+        memcpy(child + o, info.name, nlen);
+        child[o + nlen] = '\0';
+        int r = lfs2_ext_walk_meta(lfs2, child, depth+1, meta, meta_size);
+        if (r) {
+            lfs2_dir_close(lfs2, &dir);
+            return r;
+        }
+    }
+    lfs2_dir_close(lfs2, &dir);
+    return (err < 0) ? err : 0;
+}
+
+int lfs2_ext_block_maps(lfs2_t *lfs2,
+        uint8_t *used, lfs2_size_t used_size,
+        uint8_t *meta, lfs2_size_t meta_size) {
+    lfs2_size_t need = lfs2_ext_map_size(lfs2);
+    if (used && used_size < need) {
+        return LFS2_ERR_INVAL;
+    }
+    if (meta && meta_size < need) {
+        return LFS2_ERR_INVAL;
+    }
+    if (used) {
+        memset(used, 0, need);
+        struct lfs2_ext_map m = {used, need};
+        int err = lfs2_fs_traverse_(lfs2, lfs2_ext_map_cb, &m, true);
+        if (err) {
+            return err;
+        }
+    }
+    if (meta) {
+        memset(meta, 0, need);
+        int err = lfs2_ext_walk_meta(lfs2, "/", 0, meta, need);
+        if (err) {
+            return err;
+        }
+    }
+    return 0;
+}
+
+lfs2_block_t lfs2_ext_largest_run(lfs2_t *lfs2, lfs2_block_t align) {
+    if (align == 0) {
+        align = 1;
+    }
+    lfs2_size_t size = lfs2_ext_map_size(lfs2);
+    if (size > LFS2_EXT_MAP_MAX) {
+        return 0;
+    }
+    uint8_t used[LFS2_EXT_MAP_MAX];
+    memset(used, 0, size);
+    struct lfs2_ext_map m = {used, size};
+    lfs2_block_t best = 0;
+    if (lfs2_fs_traverse_(lfs2, lfs2_ext_map_cb, &m, true) == 0) {
+        for (lfs2_block_t i = 0; i < lfs2->block_count; i += align) {
+            lfs2_block_t run = 0;
+            while (i+run < lfs2->block_count
+                    && !lfs2_ext_map_get(used, i+run)) {
+                run++;
+            }
+            if (run > best) {
+                best = run;
+            }
+            if (i + run >= lfs2->block_count) {
+                break;
+            }
+        }
+    }
+    return best;
+}
+
+int lfs2_ext_file_blocks(lfs2_t *lfs2, const char *path,
+        int (*cb)(void*, lfs2_block_t), void *data) {
+    lfs2_mdir_t cwd;
+    uint16_t id;
+    lfs2_stag_t tag = lfs2_dir_find(lfs2, &cwd, &path, &id);
+    if (tag < 0) {
+        return (int)tag;
+    }
+    if (lfs2_tag_type3(tag) != LFS2_TYPE_REG) {
+        return LFS2_ERR_ISDIR;
+    }
+
+    lfs2_ext_t ext;
+    lfs2_stag_t xtag = lfs2_dir_get(lfs2, &cwd, LFS2_MKTAG(0x7ff, 0x3ff, 0),
+            LFS2_MKTAG(LFS2_TYPE_EXTSTRUCT, id, sizeof(ext)), &ext);
+    if (xtag >= 0) {
+        lfs2_ext_fromle32(&ext);
+        if (!lfs2_ext_valid(lfs2, &ext)) {
+            return LFS2_ERR_CORRUPT;
+        }
+        for (lfs2_block_t b = ext.head; b < ext.head+ext.count; b++) {
+            int err = cb(data, b);
+            if (err) {
+                return err;
+            }
+        }
+        return 0;
+    } else if (xtag != LFS2_ERR_NOENT) {
+        return (int)xtag;
+    }
+
+    struct lfs2_ctz ctz;
+    lfs2_stag_t t = lfs2_dir_get(lfs2, &cwd, LFS2_MKTAG(0x700, 0x3ff, 0),
+            LFS2_MKTAG(LFS2_TYPE_STRUCT, id, sizeof(ctz)), &ctz);
+    if (t < 0) {
+        if (t == LFS2_ERR_NOENT) {
+            return 0;
+        }
+        return (int)t;
+    }
+    lfs2_ctz_fromle32(&ctz);
+    if (lfs2_tag_type3(t) == LFS2_TYPE_CTZSTRUCT) {
+        return lfs2_ctz_traverse(lfs2, NULL, &lfs2->rcache,
+                ctz.head, ctz.size, cb, data);
+    }
+    return 0;
+}
+
+#ifndef LFS2_READONLY
+int lfs2_ext_exclude(lfs2_t *lfs2, lfs2_block_t head, lfs2_block_t count) {
+    if (head >= lfs2->block_count
+            || count > lfs2->block_count - head) {
+        return LFS2_ERR_INVAL;
+    }
+    lfs2_size_t size = lfs2_ext_map_size(lfs2);
+    if (size > LFS2_EXT_MAP_MAX) {
+        return LFS2_ERR_NOMEM;
+    }
+    memset(lfs2->ext_map, 0, size);
+    lfs2->ext_bitmap = lfs2->ext_map;
+    lfs2->ext_head = head;
+    lfs2->ext_count = count;
+    for (lfs2_block_t b = head; b < head+count; b++) {
+        lfs2_ext_map_set(lfs2->ext_bitmap, b);
+    }
+    return 0;
+}
+
+void lfs2_ext_clear_exclude(lfs2_t *lfs2) {
+    lfs2->ext_bitmap = NULL;
+    lfs2->ext_head = 0;
+    lfs2->ext_count = 0;
+    lfs2->ext_length = 0;
+}
+
+int lfs2_ext_reserve(lfs2_t *lfs2, lfs2_size_t length, lfs2_block_t align,
+        lfs2_ext_t *out) {
+    if (!out || length == 0) {
+        return LFS2_ERR_INVAL;
+    }
+    if (align == 0) {
+        align = 1;
+    }
+    lfs2_size_t bs = lfs2->cfg->block_size;
+    lfs2_block_t count = (length + bs - 1) / bs;
+    if (count == 0 || count > lfs2->block_count) {
+        return LFS2_ERR_NOSPC;
+    }
+
+    // Drop any previous reservation/exclusion.
+    lfs2_ext_clear_exclude(lfs2);
+
+    lfs2_size_t size = lfs2_ext_map_size(lfs2);
+    if (size > LFS2_EXT_MAP_MAX) {
+        return LFS2_ERR_NOMEM;
+    }
+    uint8_t used[LFS2_EXT_MAP_MAX];
+    memset(used, 0, size);
+    struct lfs2_ext_map m = {used, size};
+    int err = lfs2_fs_traverse_(lfs2, lfs2_ext_map_cb, &m, true);
+    if (err) {
+        return err;
+    }
+    uint8_t *reserved = lfs2->ext_map;
+    memset(reserved, 0, size);
+
+    lfs2_block_t head = 0;
+    bool found = false;
+    for (int attempt = 0; attempt < 16 && !found; attempt++) {
+        head = 0;
+        while (head + count <= lfs2->block_count) {
+            if (head % align != 0) {
+                head += align - (head % align);
+                continue;
+            }
+            lfs2_block_t i;
+            for (i = 0; i < count; i++) {
+                if (lfs2_ext_map_get(used, head+i)
+                        || lfs2_ext_map_get(reserved, head+i)) {
+                    break;
+                }
+            }
+            if (i == count) {
+                break;
+            }
+            head += align;
+        }
+        if (head + count > lfs2->block_count) {
+            break;
+        }
+
+        // Erase the candidate. A bad block disqualifies it; try the next run.
+        bool bad = false;
+        for (lfs2_block_t i = 0; i < count; i++) {
+            err = lfs2_bd_erase(lfs2, head+i);
+            if (err) {
+                if (err == LFS2_ERR_CORRUPT) {
+                    lfs2_ext_map_set(used, head+i);
+                    bad = true;
+                    break;
+                }
+                return err;
+            }
+        }
+        if (bad) {
+            // Skip past the bad block and search again.
+            for (lfs2_block_t i = 0; i < count; i++) {
+                if (lfs2_ext_map_get(used, head+i)) {
+                    head = head+i+1;
+                    break;
+                }
+            }
+            continue;
+        }
+        found = true;
+    }
+
+    if (!found) {
+        return LFS2_ERR_NOCONTIG;
+    }
+
+    for (lfs2_block_t b = head; b < head+count; b++) {
+        lfs2_ext_map_set(reserved, b);
+    }
+    lfs2->ext_bitmap = reserved;
+    lfs2->ext_head = head;
+    lfs2->ext_count = count;
+    lfs2->ext_length = length;
+    out->head = head;
+    out->count = count;
+    out->length = length;
+    out->crc = 0;
+    out->flags = 0;
+    return 0;
+}
+
+int lfs2_ext_write(lfs2_t *lfs2, lfs2_size_t offset,
+        const void *buffer, lfs2_size_t size) {
+    if (!lfs2->ext_bitmap || lfs2->ext_count == 0) {
+        return LFS2_ERR_INVAL;
+    }
+    lfs2_size_t bs = lfs2->cfg->block_size;
+    if (offset > (lfs2_size_t)lfs2->ext_count * bs
+            || size > (lfs2_size_t)lfs2->ext_count * bs - offset) {
+        return LFS2_ERR_INVAL;
+    }
+    const uint8_t *data = buffer;
+    while (size > 0) {
+        lfs2_block_t block = lfs2->ext_head + offset / bs;
+        lfs2_off_t off = offset % bs;
+        lfs2_size_t n = lfs2_min(size, bs - (lfs2_size_t)off);
+        int err = lfs2_bd_prog(lfs2, &lfs2->pcache, &lfs2->rcache, true,
+                block, off, data, n);
+        if (err) {
+            return err;
+        }
+        data += n;
+        offset += n;
+        size -= n;
+    }
+    return 0;
+}
+
+int lfs2_ext_commit(lfs2_t *lfs2, const char *path, uint32_t crc) {
+    if (!lfs2->ext_bitmap || lfs2->ext_count == 0) {
+        return LFS2_ERR_INVAL;
+    }
+
+    int err = lfs2_bd_sync(lfs2, &lfs2->pcache, &lfs2->rcache, false);
+    if (err) {
+        lfs2_ext_clear_exclude(lfs2);
+        return err;
+    }
+
+    lfs2_ext_t ext;
+    ext.head = lfs2->ext_head;
+    ext.count = lfs2->ext_count;
+    ext.length = lfs2->ext_length;
+    ext.crc = crc;
+    ext.flags = 0;
+
+    lfs2_mdir_t cwd;
+    uint16_t id;
+    lfs2_stag_t tag = lfs2_dir_find(lfs2, &cwd, &path, &id);
+    if (tag < 0 && tag != LFS2_ERR_NOENT) {
+        lfs2_ext_clear_exclude(lfs2);
+        return (int)tag;
+    }
+
+    if (tag >= 0) {
+        if (lfs2_tag_type3(tag) != LFS2_TYPE_REG) {
+            lfs2_ext_clear_exclude(lfs2);
+            return LFS2_ERR_ISDIR;
+        }
+        // Find the data tag this commit replaces (CTZ, inline or extent).
+        struct lfs2_ctz ctz;
+        lfs2_stag_t old = lfs2_dir_get(lfs2, &cwd,
+                LFS2_MKTAG(0x700, 0x3ff, 0),
+                LFS2_MKTAG(LFS2_TYPE_STRUCT, id, sizeof(ctz)), &ctz);
+        if (old < 0 && old != LFS2_ERR_NOENT) {
+            lfs2_ext_clear_exclude(lfs2);
+            return (int)old;
+        }
+        uint16_t oldtype = (old >= 0)
+                ? lfs2_tag_type3(old) : LFS2_TYPE_INLINESTRUCT;
+        lfs2_ext_tole32(&ext);
+        err = lfs2_dir_commit(lfs2, &cwd, LFS2_MKATTRS(
+                {LFS2_MKTAG(oldtype, id, 0x3ff), NULL},
+                {LFS2_MKTAG(LFS2_TYPE_EXTSTRUCT, id, sizeof(ext)), &ext}));
+    } else {
+        lfs2_size_t nlen = lfs2_path_namelen(path);
+        if (nlen > lfs2->name_max) {
+            lfs2_ext_clear_exclude(lfs2);
+            return LFS2_ERR_NAMETOOLONG;
+        }
+        lfs2_ext_tole32(&ext);
+        err = lfs2_dir_commit(lfs2, &cwd, LFS2_MKATTRS(
+                {LFS2_MKTAG(LFS2_TYPE_CREATE, id, 0), NULL},
+                {LFS2_MKTAG(LFS2_TYPE_REG, id, nlen), path},
+                {LFS2_MKTAG(LFS2_TYPE_EXTSTRUCT, id, sizeof(ext)), &ext}));
+    }
+
+    lfs2_ext_clear_exclude(lfs2);
+    return err;
+}
+
+void lfs2_ext_abort(lfs2_t *lfs2) {
+    lfs2_ext_clear_exclude(lfs2);
+}
+#endif
+
+int lfs2_ext_info(lfs2_t *lfs2, const char *path, lfs2_ext_t *out) {
+    lfs2_mdir_t cwd;
+    uint16_t id;
+    lfs2_stag_t tag = lfs2_dir_find(lfs2, &cwd, &path, &id);
+    if (tag < 0) {
+        return (int)tag;
+    }
+    if (lfs2_tag_type3(tag) != LFS2_TYPE_REG) {
+        return LFS2_ERR_ISDIR;
+    }
+    lfs2_ext_t ext;
+    lfs2_stag_t xtag = lfs2_dir_get(lfs2, &cwd, LFS2_MKTAG(0x7ff, 0x3ff, 0),
+            LFS2_MKTAG(LFS2_TYPE_EXTSTRUCT, id, sizeof(ext)), &ext);
+    if (xtag < 0) {
+        return (int)xtag;
+    }
+    lfs2_ext_fromle32(&ext);
+    if (!lfs2_ext_valid(lfs2, &ext)) {
+        return LFS2_ERR_CORRUPT;
+    }
+    if (out) {
+        *out = ext;
+    }
+    return 0;
+}
+
+lfs2_size_t lfs2_fs_block_count(lfs2_t *lfs2) {
+    return lfs2->block_count;
+}
