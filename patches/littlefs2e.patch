+    bool found = false;
+    for (int attempt = 0; attempt < 16 && !found; attempt++) {
+        head = 0;
+        while (head + count <= lfs2->block_count) {
+            if (head % align != 0) {
+                head += align - (head % align);
+                continue;
+            }
+            lfs2_block_t i;
+            for (i = 0; i < count; i++) {
+                if (lfs2_ext_map_get(used, head+i)
+                        || lfs2_ext_map_get(reserved, head+i)) {
+                    break;
+                }
+            }
+            if (i == count) {
+                break;
+            }
+            head += align;
+        }
+        if (head + count > lfs2->block_count) {
+            break;
+        }
+
+        // Erase the candidate. A bad block disqualifies it; try the next run.
+        bool bad = false;
+        for (lfs2_block_t i = 0; i < count; i++) {
+            err = lfs2_bd_erase(lfs2, head+i);
+            if (err) {
+                if (err == LFS2_ERR_CORRUPT) {
+                    lfs2_ext_map_set(used, head+i);
+                    bad = true;
+                    break;
+                }
+                return err;
+            }
+        }
+        if (bad) {
+            // Skip past the bad block and search again.
+            for (lfs2_block_t i = 0; i < count; i++) {
+                if (lfs2_ext_map_get(used, head+i)) {
+                    head = head+i+1;
+                    break;
+                }
+            }
+            continue;
+        }
+        found = true;
+    }
+
+    if (!found) {
+        return LFS2_ERR_NOCONTIG;
+    }
+
+    for (lfs2_block_t b = head; b < head+count; b++) {
+        lfs2_ext_map_set(reserved, b);
+    }
+    lfs2->ext_bitmap = reserved;
+    lfs2->ext_head = head;
+    lfs2->ext_count = count;
+    lfs2->ext_length = length;
+    out->head = head;
+    out->count = count;
+    out->length = length;
+    out->crc = 0;
+    out->flags = 0;
+    return 0;
+}
+
+int lfs2_ext_write(lfs2_t *lfs2, lfs2_size_t offset,
+        const void *buffer, lfs2_size_t size) {
+    if (!lfs2->ext_bitmap || lfs2->ext_count == 0) {
+        return LFS2_ERR_INVAL;
+    }
+    lfs2_size_t bs = lfs2->cfg->block_size;
+    if (offset > (lfs2_size_t)lfs2->ext_count * bs
+            || size > (lfs2_size_t)lfs2->ext_count * bs - offset) {
+        return LFS2_ERR_INVAL;
+    }
+    const uint8_t *data = buffer;
+    while (size > 0) {
+        lfs2_block_t block = lfs2->ext_head + offset / bs;
+        lfs2_off_t off = offset % bs;
+        lfs2_size_t n = lfs2_min(size, bs - (lfs2_size_t)off);
+        int err = lfs2_bd_prog(lfs2, &lfs2->pcache, &lfs2->rcache, true,
+                block, off, data, n);
+        if (err) {
+            return err;
+        }
+        data += n;
+        offset += n;
+        size -= n;
+    }
+    return 0;
+}
+
+int lfs2_ext_commit(lfs2_t *lfs2, const char *path, uint32_t crc) {
+    if (!lfs2->ext_bitmap || lfs2->ext_count == 0) {
+        return LFS2_ERR_INVAL;
+    }
+
+    int err = lfs2_bd_sync(lfs2, &lfs2->pcache, &lfs2->rcache, false);
+    if (err) {
+        lfs2_ext_clear_exclude(lfs2);
+        return err;
+    }
+
+    lfs2_ext_t ext;
+    ext.head = lfs2->ext_head;
+    ext.count = lfs2->ext_count;
+    ext.length = lfs2->ext_length;
+    ext.crc = crc;
+    ext.flags = 0;
+
+    lfs2_mdir_t cwd;
+    uint16_t id;
+    lfs2_stag_t tag = lfs2_dir_find(lfs2, &cwd, &path, &id);
+    if (tag < 0 && tag != LFS2_ERR_NOENT) {
+        lfs2_ext_clear_exclude(lfs2);
+        return (int)tag;
+    }
+
+    if (tag >= 0) {
+        if (lfs2_tag_type3(tag) != LFS2_TYPE_REG) {
+            lfs2_ext_clear_exclude(lfs2);
+            return LFS2_ERR_ISDIR;
+        }
+        // Find the data tag this commit replaces (CTZ, inline or extent).
+        struct lfs2_ctz ctz;
+        lfs2_stag_t old = lfs2_dir_get(lfs2, &cwd,
+                LFS2_MKTAG(0x700, 0x3ff, 0),
+                LFS2_MKTAG(LFS2_TYPE_STRUCT, id, sizeof(ctz)), &ctz);
+        if (old < 0 && old != LFS2_ERR_NOENT) {
+            lfs2_ext_clear_exclude(lfs2);
+            return (int)old;
+        }
+        uint16_t oldtype = (old >= 0)
+                ? lfs2_tag_type3(old) : LFS2_TYPE_INLINESTRUCT;
+        lfs2_ext_tole32(&ext);
+        err = lfs2_dir_commit(lfs2, &cwd, LFS2_MKATTRS(
+                {LFS2_MKTAG(oldtype, id, 0x3ff), NULL},
+                {LFS2_MKTAG(LFS2_TYPE_EXTSTRUCT, id, sizeof(ext)), &ext}));
+    } else {
+        lfs2_size_t nlen = lfs2_path_namelen(path);
+        if (nlen > lfs2->name_max) {
+            lfs2_ext_clear_exclude(lfs2);
+            return LFS2_ERR_NAMETOOLONG;
+        }
+        lfs2_ext_tole32(&ext);
+        err = lfs2_dir_commit(lfs2, &cwd, LFS2_MKATTRS(
+                {LFS2_MKTAG(LFS2_TYPE_CREATE, id, 0), NULL},
+                {LFS2_MKTAG(LFS2_TYPE_REG, id, nlen), path},
+                {LFS2_MKTAG(LFS2_TYPE_EXTSTRUCT, id, sizeof(ext)), &ext}));
+    }
+
+    lfs2_ext_clear_exclude(lfs2);
+    return err;
+}
+
+void lfs2_ext_abort(lfs2_t *lfs2) {
+    lfs2_ext_clear_exclude(lfs2);
+}
+#endif
+
+int lfs2_ext_info(lfs2_t *lfs2, const char *path, lfs2_ext_t *out) {
+    lfs2_mdir_t cwd;
+    uint16_t id;
+    lfs2_stag_t tag = lfs2_dir_find(lfs2, &cwd, &path, &id);
+    if (tag < 0) {
+        return (int)tag;
+    }
+    if (lfs2_tag_type3(tag) != LFS2_TYPE_REG) {
+        return LFS2_ERR_ISDIR;
+    }
+    lfs2_ext_t ext;
+    lfs2_stag_t xtag = lfs2_dir_get(lfs2, &cwd, LFS2_MKTAG(0x7ff, 0x3ff, 0),
+            LFS2_MKTAG(LFS2_TYPE_EXTSTRUCT, id, sizeof(ext)), &ext);
+    if (xtag < 0) {
+        return (int)xtag;
+    }
+    lfs2_ext_fromle32(&ext);
+    if (!lfs2_ext_valid(lfs2, &ext)) {
+        return LFS2_ERR_CORRUPT;
+    }
+    if (out) {
+        *out = ext;
+    }
+    return 0;
+}
+
+/// littlefs2e defragmenter ///
+#ifndef LFS2_READONLY
+
+// A window can only become an extent if it holds no live block at all, so the
+// directories intersecting it are relocated before the ordinary files are
+// moved out. Split-directory tail pairs cannot be relocated on their own: a
+// child is found through its DIRSTRUCT entry, while a tail is referenced by a
+// TAIL tag in the head pair (lfs2_fs_parent matches DIRSTRUCT only), so a tail
+// pair inside a window pins that window. Lifting that needs either a rewrite
+// of the head's TAIL tag to a fresh tail pair or a rebuild of the whole head
+// and tail chain into new pairs; a directory whose *head* is in the window
+// relocates normally.
+
+#define LFS2_EXT_DEFRAG_ATTEMPTS 8
+#define LFS2_EXT_MAX_PAIRS 32
+// Keep the scan's per-frame and per-window footprint small: a filesystem read
+// reaches the block device through a Python callback, which needs its own VM
+// stack, so a few kilobytes here can overflow the MicroPython task stack.
+#define LFS2_EXT_MAX_OCCUPANTS 8
+#define LFS2_EXT_MAX_PATH 96
+#define LFS2_EXT_MAX_DEPTH 6
+#define LFS2_EXT_CACHE_MAX 4096
+
+struct lfs2_ext_block_check {
+    lfs2_block_t head;
+    lfs2_block_t count;
+    lfs2_block_t blocks;
+    bool hit;
+};
+
+struct lfs2_ext_occupant {
+    char path[LFS2_EXT_MAX_PATH];
+    lfs2_size_t size;
+    lfs2_block_t blocks;
+};
+
+struct lfs2_ext_window {
+    lfs2_block_t head;
+    lfs2_block_t count;
+    lfs2_block_t pairs[LFS2_EXT_MAX_PAIRS][2];
+    int pair_count;
+    struct lfs2_ext_occupant files[LFS2_EXT_MAX_OCCUPANTS];
+    int file_count;
+    lfs2_block_t moved_blocks;
+    lfs2_block_t max_file_blocks;
+    struct lfs2_info info;
+    bool reject;
+};
+
+static bool lfs2_ext_in_window(lfs2_block_t block,
+        lfs2_block_t head, lfs2_block_t count) {
+    return block >= head && block < head + count;
+}
+
+static int lfs2_ext_block_check_cb(void *data, lfs2_block_t block) {
+    struct lfs2_ext_block_check *check = data;
+    check->blocks += 1;
+    if (lfs2_ext_in_window(block, check->head, check->count)) {
+        check->hit = true;
+    }
+    return 0;
+}
+
+static int lfs2_ext_used_into(lfs2_t *lfs2, uint8_t *map) {
+    lfs2_size_t size = lfs2_ext_map_size(lfs2);
+    memset(map, 0, size);
+    struct lfs2_ext_map m = {map, size};
+    return lfs2_fs_traverse_(lfs2, lfs2_ext_map_cb, &m, true);
+}
+
+// Reject a window that an open file still holds data blocks in: the caller's
+// handle would keep reading the old blocks after the copy frees them.
+static bool lfs2_ext_open_hits(lfs2_t *lfs2,
+        lfs2_block_t head, lfs2_block_t count) {
+    for (struct lfs2_mlist *d = lfs2->mlist; d; d = d->next) {
+        lfs2_file_t *file = (lfs2_file_t*)d;
+        if (file->type != LFS2_TYPE_REG || (file->flags & LFS2_F_INLINE)) {
+            continue;
+        }
+        struct lfs2_ext_block_check check = {head, count, 0, false};
+        if (file->ctz.size && lfs2_ctz_traverse(lfs2,
+                &file->cache, &lfs2->rcache,
+                file->ctz.head, file->ctz.size,
+                lfs2_ext_block_check_cb, &check)) {
+            return true;
+        }
+        if ((file->flags & LFS2_F_WRITING) && file->pos && lfs2_ctz_traverse(
+                lfs2, &file->cache, &lfs2->rcache,
+                file->block, file->pos,
+                lfs2_ext_block_check_cb, &check)) {
+            return true;
+        }
+        if (check.hit) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Record a head pair that must be relocated, or reject the window for a tail
+// pair (which cannot move on its own).
+static int lfs2_ext_scan_pair(const lfs2_block_t pair[2],
+        struct lfs2_ext_window *w) {
+    if (lfs2_ext_in_window(pair[0], w->head, w->count)
+            || lfs2_ext_in_window(pair[1], w->head, w->count)) {
+        if (w->pair_count >= LFS2_EXT_MAX_PAIRS) {
+            w->reject = true;
+            return 0;
+        }
+        w->pairs[w->pair_count][0] = pair[0];
+        w->pairs[w->pair_count][1] = pair[1];
+        w->pair_count += 1;
+    }
+    return 0;
+}
+
+static int lfs2_ext_move_file(lfs2_t *lfs2, const char *path,
+        uint8_t *inbuf, uint8_t *outbuf, uint8_t *copy) {
+    char tmp[LFS2_EXT_MAX_PATH+4];
+    lfs2_size_t plen = strlen(path);
+    if (plen + 4 > sizeof(tmp)) {
+        return LFS2_ERR_NAMETOOLONG;
+    }
+    memcpy(tmp, path, plen);
+    memcpy(tmp + plen, ".dfg", 5);
+
+    int err = lfs2_remove(lfs2, tmp);
+    if (err && err != LFS2_ERR_NOENT) {
+        return err;
+    }
+
+    struct lfs2_file_config incfg = {.buffer = inbuf, .attrs = NULL};
+    struct lfs2_file_config outcfg = {.buffer = outbuf, .attrs = NULL};
+    lfs2_file_t in;
+    lfs2_file_t out;
+    lfs2_size_t chunk = lfs2->cfg->cache_size;
+
+    err = lfs2_file_opencfg(lfs2, &in, path, LFS2_O_RDONLY, &incfg);
+    if (err) {
+        return err;
+    }
+    err = lfs2_file_opencfg(lfs2, &out, tmp,
+            LFS2_O_WRONLY | LFS2_O_CREAT | LFS2_O_TRUNC, &outcfg);
+    if (err) {
+        lfs2_file_close(lfs2, &in);
+        lfs2_remove(lfs2, tmp);
+        return err;
+    }
+
+    while (true) {
+        lfs2_ssize_t n = lfs2_file_read(lfs2, &in, copy, chunk);
+        if (n < 0) {
+            err = (int)n;
+            break;
+        }
+        if (n == 0) {
+            err = 0;
+            break;
+        }
+        lfs2_ssize_t written = lfs2_file_write(lfs2, &out, copy, n);
+        if (written != n) {
+            err = (written < 0) ? (int)written : LFS2_ERR_IO;
+            break;
+        }
+    }
+    int cerr = lfs2_file_close(lfs2, &in);
+    if (!err) {
+        err = cerr;
+    }
+    cerr = lfs2_file_close(lfs2, &out);
+    if (!err) {
+        err = cerr;
+    }
+    if (err) {
+        lfs2_remove(lfs2, tmp);
+        return err;
+    }
+
+    err = lfs2_rename(lfs2, tmp, path);
+    if (err) {
+        lfs2_remove(lfs2, tmp);
+    }
+    return err;
+}
+
+// The scan walks directories by pair, from DIRSTRUCT tags, because a path
+// lookup costs a full metadata scan per component and every tag read reaches
+// flash through a Python callback. It is iterative (one frame per open
+// directory) so a step can stop between entries without using the C stack.
+struct lfs2_ext_scan_frame {
+    lfs2_block_t pair[2];
+    char path[LFS2_EXT_MAX_PATH];
+    uint16_t id;        // next entry of this directory
+    uint16_t tails;     // tail pairs followed so far
+    bool fetched;       // `cur` holds this frame's mdir
+};
+
+enum {
+    LFS2_EXT_STATE_RANK,
+    LFS2_EXT_STATE_SCAN,
+    LFS2_EXT_STATE_WORK,
+    LFS2_EXT_STATE_ERASE,
+    LFS2_EXT_STATE_DONE,
+};
+
+// One defragmenter at a time: the OS has one root filesystem and serialises
+// installs, and the state is too large for the task stack.
+struct lfs2_ext_defrag_state {
+    bool active;
+    bool fixed;
+    bool map_built;
+    bool excluded;
+    lfs2_t *lfs2;
+    lfs2_size_t length;
+    lfs2_block_t count;
+    lfs2_block_t align;
+    lfs2_size_t budget;
+    uint8_t state;
+    lfs2_block_t head;
+    lfs2_block_t tried[LFS2_EXT_DEFRAG_ATTEMPTS];
+    int tried_count;
+    lfs2_block_t free_blocks;
+    lfs2_size_t moved;
+    int rounds;
+    struct lfs2_ext_window w;
+    struct lfs2_ext_scan_frame stack[LFS2_EXT_MAX_DEPTH+1];
+    int depth;
+    lfs2_mdir_t cur;
+    int pair_index;
+    int file_index;
+    lfs2_block_t erase_next;
+    lfs2_ext_t out;
+    uint8_t file_in[LFS2_EXT_CACHE_MAX];
+    uint8_t file_out[LFS2_EXT_CACHE_MAX];
+    uint8_t copy[LFS2_EXT_CACHE_MAX];
+    lfs2_cache_t check;
+    uint8_t check_buf[LFS2_EXT_CACHE_MAX];
+};
+
+static struct lfs2_ext_defrag_state lfs2_ext_defrag_state;
+
+static void lfs2_ext_scan_reset(struct lfs2_ext_defrag_state *s) {
+    memset(&s->w, 0, sizeof(s->w));
+    s->w.head = s->head;
+    s->w.count = s->count;
+    s->depth = 0;
+    s->stack[0].pair[0] = s->lfs2->root[0];
+    s->stack[0].pair[1] = s->lfs2->root[1];
+    strcpy(s->stack[0].path, "/");
+    s->stack[0].id = 0;
+    s->stack[0].tails = 0;
+    s->stack[0].fetched = false;
+    s->pair_index = 0;
+    s->file_index = 0;
+    lfs2_ext_scan_pair(s->lfs2->root, &s->w);
+}
+
+// Process at most one entry (or one directory fetch/pop). Returns 1 while the
+// scan has more to do, 0 when it finished, or a negative error.
+static int lfs2_ext_scan_step(struct lfs2_ext_defrag_state *s) {
+    lfs2_t *lfs2 = s->lfs2;
+
+    if (s->w.reject) {
+        return 0;
+    }
+    if (s->depth < 0) {
+        return 0;
+    }
+
+    struct lfs2_ext_scan_frame *frame = &s->stack[s->depth];
+    if (!frame->fetched) {
+        int err = lfs2_dir_fetch(lfs2, &s->cur, frame->pair);
+        if (err) {
+            return err;
+        }
+        frame->fetched = true;
+        return 1;
+    }
+
+    if (frame->id >= s->cur.count) {
+        if (s->cur.split) {
+            if (++frame->tails > 128) {
+                return LFS2_ERR_CORRUPT;
+            }
+            // A split directory's tail pair belongs to this directory and is
+            // not a relocate target; a window holding one is pinned.
+            if (lfs2_ext_in_window(s->cur.tail[0], s->head, s->count)
+                    || lfs2_ext_in_window(s->cur.tail[1],
+                        s->head, s->count)) {
+                s->w.reject = true;
+                return 0;
+            }
+            int err = lfs2_dir_fetch(lfs2, &s->cur, s->cur.tail);
+            if (err) {
+                return err;
+            }
+            frame->id = 0;
+            return 1;
+        }
+        if (s->depth == 0) {
+            s->depth = -1;
+            return 0;
+        }
+        // The parent's cursor is kept; its mdir has to be fetched again
+        // because `cur` now holds a descendant.
+        s->depth -= 1;
+        s->stack[s->depth].fetched = false;
+        return 1;
+    }
+
+    uint16_t id = frame->id++;
+    // One lookup covers every data tag: the 0x700 mask keeps the type but not
+    // the chunk, so DIRSTRUCT, INLINESTRUCT, CTZSTRUCT and EXTSTRUCT all
+    // match and are told apart by type3. The first 12 bytes are enough for a
+    // ctz (head/size), a DIRSTRUCT pair and an extent's head/count.
+    union {
+        struct lfs2_ctz ctz;
+        lfs2_ext_t ext;
+    } data;
+    lfs2_stag_t tag = lfs2_dir_get(lfs2, &s->cur,
+            LFS2_MKTAG(0x700, 0x3ff, 0),
+            LFS2_MKTAG(LFS2_TYPE_STRUCT, id, sizeof(struct lfs2_ctz)),
+            &data);
+    if (tag == LFS2_ERR_NOENT) {
+        return 1;
+    }
+    if (tag < 0) {
+        return (int)tag;
+    }
+
+    if (lfs2_tag_type3(tag) == LFS2_TYPE_EXTSTRUCT) {
+        // An extent's payload is immutable: reject the window instead of
+        // moving or writing over it.
+        lfs2_block_t ehead = lfs2_fromle32((&data.ctz.head)[0]);
+        lfs2_block_t ecount = lfs2_fromle32((&data.ctz.head)[1]);
+        if (ecount
+                && ehead < s->head + s->count
+                && s->head < ehead + ecount) {
+            s->w.reject = true;
+        }
+        return 1;
+    }
+
+    lfs2_block_t child_pair[2] = {0, 0};
+    bool is_dir = false;
+    bool hit = false;
+    lfs2_block_t file_blocks = 0;
+    if (lfs2_tag_type3(tag) == LFS2_TYPE_DIRSTRUCT) {
+        child_pair[0] = (&data.ctz.head)[0];
+        child_pair[1] = (&data.ctz.head)[1];
+        lfs2_pair_fromle32(child_pair);
+        is_dir = true;
+    } else if (lfs2_tag_type3(tag) == LFS2_TYPE_CTZSTRUCT) {
+        lfs2_ctz_fromle32(&data.ctz);
+        struct lfs2_ext_block_check check = {s->head, s->count, 0, false};
+        int err = lfs2_ctz_traverse(lfs2, NULL, &s->check,
+                data.ctz.head, data.ctz.size,
+                lfs2_ext_block_check_cb, &check);
+        if (err) {
+            return err;
+        }
+        hit = check.hit;
+        file_blocks = check.blocks;
+    } else {
+        // Inline data (or no data tag): nothing outside the pair.
+        return 1;
+    }
+
+    if (!is_dir && !hit) {
+        return 1;
+    }
+
+    // The name is only needed for entries the window keeps, and it is another
+    // full metadata scan.
+    lfs2_stag_t ntag = lfs2_dir_get(lfs2, &s->cur,
+            LFS2_MKTAG(0x780, 0x3ff, 0),
+            LFS2_MKTAG(LFS2_TYPE_NAME, id, LFS2_NAME_MAX+1),
+            s->w.info.name);
+    if (ntag == LFS2_ERR_NOENT) {
+        return 1;
+    }
+    if (ntag < 0) {
+        return (int)ntag;
+    }
+    s->w.info.name[lfs2_tag_size(ntag)] = '\0';
+
+    lfs2_size_t plen = strlen(frame->path);
+    lfs2_size_t nlen = strlen(s->w.info.name);
+    bool slash = strcmp(frame->path, "/") != 0;
+    if (plen + (slash ? 1 : 0) + nlen + 1 > LFS2_EXT_MAX_PATH) {
+        // Cannot address the entry; the final used-map check refuses a window
+        // it occupies.
+        return 1;
+    }
+    char child[LFS2_EXT_MAX_PATH];
+    memcpy(child, frame->path, plen);
+    lfs2_size_t o = plen;
+    if (slash) {
+        child[o++] = '/';
+    }
+    memcpy(child + o, s->w.info.name, nlen);
+    child[o + nlen] = '\0';
+
+    if (is_dir) {
+        int err = lfs2_ext_scan_pair(child_pair, &s->w);
+        if (err || s->w.reject) {
+            return err;
+        }
+        if (s->depth < LFS2_EXT_MAX_DEPTH) {
+            s->depth += 1;
+            struct lfs2_ext_scan_frame *child_frame = &s->stack[s->depth];
+            child_frame->pair[0] = child_pair[0];
+            child_frame->pair[1] = child_pair[1];
+            memcpy(child_frame->path, child, o + nlen + 1);
+            child_frame->id = 0;
+            child_frame->tails = 0;
+            child_frame->fetched = false;
+        }
+        return 1;
+    }
+
+    if (s->w.file_count >= LFS2_EXT_MAX_OCCUPANTS) {
+        // More than one round can carry; the next round picks these up.
+        return 1;
+    }
+    struct lfs2_ext_occupant *occ = &s->w.files[s->w.file_count];
+    memcpy(occ->path, child, o + nlen + 1);
+    occ->size = data.ctz.size;
+    occ->blocks = file_blocks;
+    s->w.file_count += 1;
+    s->w.moved_blocks += file_blocks + 1;
+    if (file_blocks > s->w.max_file_blocks) {
+        s->w.max_file_blocks = file_blocks;
+    }
+    return 1;
+}
+
+static int lfs2_ext_defrag_begin_common(lfs2_t *lfs2, lfs2_size_t length,
+        lfs2_block_t align, lfs2_size_t budget_blocks, bool fixed,
+        lfs2_block_t head, lfs2_block_t count) {
+    if (lfs2_ext_defrag_state.active || lfs2->ext_bitmap) {
+        return LFS2_ERR_INVAL;
+    }
+    if (align == 0) {
+        align = 1;
+    }
+    lfs2_size_t bs = lfs2->cfg->block_size;
+    if (count == 0) {
+        count = (length + bs - 1) / bs;
+    }
+    if (count == 0 || count > lfs2->block_count
+            || (fixed && head >= lfs2->block_count)
+            || (fixed && count > lfs2->block_count - head)) {
+        return LFS2_ERR_NOSPC;
+    }
+    if (lfs2_ext_map_size(lfs2) > LFS2_EXT_MAP_MAX
+            || lfs2->cfg->cache_size > LFS2_EXT_CACHE_MAX) {
+        return LFS2_ERR_NOMEM;
+    }
+
+    memset(&lfs2_ext_defrag_state, 0, sizeof(lfs2_ext_defrag_state));
+    struct lfs2_ext_defrag_state *s = &lfs2_ext_defrag_state;
+    // A private read cache for the per-entry data-block walks: reusing the
+    // shared one would evict the directory block that the next entry's tag
+    // scan needs.
+    s->check.buffer = s->check_buf;
+    s->check.block = LFS2_BLOCK_NULL;
+    s->active = true;
+    s->fixed = fixed;
+    s->lfs2 = lfs2;
+    s->length = length;
+    s->count = count;
+    s->align = align;
+    s->budget = budget_blocks;
+    s->head = head;
+    s->state = LFS2_EXT_STATE_RANK;
+    return 0;
+}
+
+int lfs2_ext_defrag_begin(lfs2_t *lfs2, lfs2_size_t length,
+        lfs2_block_t align, lfs2_size_t budget_blocks) {
+    if (length == 0) {
+        return LFS2_ERR_INVAL;
+    }
+    return lfs2_ext_defrag_begin_common(lfs2, length, align, budget_blocks,
+            false, LFS2_BLOCK_NULL, 0);
+}
+
+void lfs2_ext_defrag_abort(lfs2_t *lfs2) {
+    struct lfs2_ext_defrag_state *s = &lfs2_ext_defrag_state;
+    if (!s->active) {
+        return;
+    }
+    if (s->excluded) {
+        lfs2_ext_clear_exclude(lfs2);
+    }
+    s->active = false;
+}
+
+int lfs2_ext_defrag_result(lfs2_t *lfs2, lfs2_ext_t *out) {
+    (void)lfs2;
+    if (!out || lfs2_ext_defrag_state.state != LFS2_EXT_STATE_DONE) {
+        return LFS2_ERR_INVAL;
+    }
+    *out = lfs2_ext_defrag_state.out;
+    return 0;
+}
+
+// Run one bounded unit of work. Returns 1 while there is more to do, 0 when the
+// window is cleared (and, for a reservation, the run is reserved), or a
+// negative error. `phase`/`percent` may be NULL.
+static int lfs2_ext_reserve_mark(lfs2_t *lfs2, lfs2_block_t head,
+        lfs2_block_t count, lfs2_size_t length, lfs2_ext_t *out);
+
+int lfs2_ext_defrag_step(lfs2_t *lfs2, uint8_t *phase, uint8_t *percent) {
+    struct lfs2_ext_defrag_state *s = &lfs2_ext_defrag_state;
+    if (!s->active || s->lfs2 != lfs2) {
+        return LFS2_ERR_INVAL;
+    }
+
+    int err = 0;
+    switch (s->state) {
+    case LFS2_EXT_STATE_RANK: {
+        if (!s->map_built) {
+            err = lfs2_ext_used_into(lfs2, lfs2->ext_map);
+            if (err) {
+                break;
+            }
+            lfs2_block_t used_blocks = 0;
+            for (lfs2_block_t b = 0; b < lfs2->block_count; b++) {
+                used_blocks += lfs2_ext_map_get(lfs2->ext_map, b);
+            }
+            // Moving a file frees its old blocks inside the window and takes
+            // its copy from outside it, so this is a lower bound.
+            s->free_blocks = lfs2->block_count - used_blocks;
+            s->map_built = true;
+        }
+
+        if (s->fixed) {
+            if (lfs2_ext_in_window(0, s->head, s->count)
+                    || lfs2_ext_in_window(1, s->head, s->count)) {
+                err = LFS2_ERR_NOSPC;
+                break;
+            }
+            s->state = LFS2_EXT_STATE_SCAN;
+            lfs2_ext_scan_reset(s);
+            break;
+        }
+
+        // Rank the aligned windows by how many used blocks they hold and take
+        // the best one not tried yet.
+        lfs2_block_t best = LFS2_BLOCK_NULL;
+        lfs2_block_t best_used = 0;
+        for (lfs2_block_t h = 0; h + s->count <= lfs2->block_count;
+                h += s->align) {
+            bool skip = false;
+            for (int i = 0; i < s->tried_count; i++) {
+                if (s->tried[i] == h) {
+                    skip = true;
+                    break;
+                }
+            }
+            if (skip) {
+                continue;
+            }
+            lfs2_block_t in_window = 0;
+            for (lfs2_block_t b = h; b < h+s->count; b++) {
+                in_window += lfs2_ext_map_get(lfs2->ext_map, b);
+            }
+            if (best == LFS2_BLOCK_NULL || in_window < best_used) {
+                best = h;
+                best_used = in_window;
+            }
+        }
+        if (best == LFS2_BLOCK_NULL || s->tried_count >= LFS2_EXT_DEFRAG_ATTEMPTS) {
+            err = LFS2_ERR_NOSPC;
+            break;
+        }
+        s->tried[s->tried_count++] = best;
+        s->head = best;
+        s->state = LFS2_EXT_STATE_SCAN;
+        lfs2_ext_scan_reset(s);
+        break;
+    }
+
+    case LFS2_EXT_STATE_SCAN: {
+        int res = lfs2_ext_scan_step(s);
+        if (res < 0) {
+            err = res;
+            break;
+        }
+        if (res > 0) {
+            break;
+        }
+        if (s->w.reject) {
+            // Unusable window: drop it and look for another.
+            if (s->fixed) {
+                err = LFS2_ERR_NOSPC;
+            } else {
+                s->state = LFS2_EXT_STATE_RANK;
+                s->map_built = false;
+            }
+            break;
+        }
+        if (s->w.pair_count == 0 && s->w.file_count == 0) {
+            // Nothing live is left in the window.
+            if (s->fixed) {
+                s->state = LFS2_EXT_STATE_DONE;
+            } else {
+                s->state = LFS2_EXT_STATE_ERASE;
+                s->erase_next = s->head;
+            }
+            break;
+        }
+        if (s->budget && s->moved + s->w.moved_blocks > s->budget) {
+            err = LFS2_ERR_NOSPC;
+            break;
+        }
+        if (lfs2_ext_open_hits(lfs2, s->head, s->count)) {
+            // An open file's blocks are in this window, so it cannot be
+            // cleared. Drop this candidate and let the rank pick another.
+            if (s->fixed) {
+                err = LFS2_ERR_NOSPC;
+            } else {
+                s->state = LFS2_EXT_STATE_RANK;
+                s->map_built = false;
+            }
+            break;
+        }
+        if (s->free_blocks < s->w.max_file_blocks + 2 + 2*s->w.pair_count) {
+            err = LFS2_ERR_NOSPC;
+            break;
+        }
+
+        err = lfs2_ext_exclude(lfs2, s->head, s->count);
+        if (err) {
+            break;
+        }
+        s->excluded = true;
+        s->state = LFS2_EXT_STATE_WORK;
+        break;
+    }
+
+    case LFS2_EXT_STATE_WORK: {
+        if (s->pair_index < s->w.pair_count) {
+            lfs2_block_t pair[2] = {
+                s->w.pairs[s->pair_index][0],
+                s->w.pairs[s->pair_index][1],
+            };
+            s->pair_index += 1;
+            int res = lfs2_ext_relocate_dir(lfs2, pair);
+            if (res && res != LFS2_ERR_NOSPC) {
+                err = res;
+            }
+            break;
+        }
+        if (s->file_index < s->w.file_count) {
+            int res = lfs2_ext_move_file(lfs2,
+                    s->w.files[s->file_index].path,
+                    s->file_in, s->file_out, s->copy);
+            s->file_index += 1;
+            if (res) {
+                err = res;
+            }
+            break;
+        }
+
+        // This round's occupants are out; scan again for the next round.
+        s->moved += s->w.moved_blocks;
+        lfs2_ext_clear_exclude(lfs2);
+        s->excluded = false;
+        s->rounds += 1;
+        // An occupant holds at least one block, so this bounds the rounds.
+        if (s->rounds > (int)(s->count / LFS2_EXT_MAX_OCCUPANTS) + 2) {
+            err = LFS2_ERR_NOSPC;
+            break;
+        }
+        s->state = LFS2_EXT_STATE_SCAN;
+        lfs2_ext_scan_reset(s);
+        break;
+    }
+
+    case LFS2_EXT_STATE_ERASE: {
+        bool corrupt = false;
+        for (int i = 0; i < 8 && s->erase_next < s->head + s->count; i++) {
+            int res = lfs2_bd_erase(lfs2, s->erase_next);
+            s->erase_next += 1;
+            if (res) {
+                if (res == LFS2_ERR_CORRUPT) {
+                    corrupt = true;
+                    break;
+                }
+                err = res;
+                break;
+            }
+        }
+        if (err) {
+            break;
+        }
+        if (corrupt) {
+            // A bad block disqualifies this window; try the next one.
+            s->map_built = false;
+            s->state = LFS2_EXT_STATE_RANK;
+            break;
+        }
+        if (s->erase_next < s->head + s->count) {
+            break;
+        }
+        err = lfs2_ext_reserve_mark(lfs2, s->head, s->count, s->length,
+                &s->out);
+        if (err) {
+            break;
+        }
+        s->excluded = false;    // the reservation owns the map now
+        s->state = LFS2_EXT_STATE_DONE;
+        break;
+    }
+
+    case LFS2_EXT_STATE_DONE:
+        break;
+    }
+
+    if (err) {
+        lfs2_ext_defrag_abort(lfs2);
+        return err;
+    }
+
+    if (phase) {
+        if (s->state == LFS2_EXT_STATE_RANK
+                || s->state == LFS2_EXT_STATE_SCAN) {
+            *phase = LFS2_EXT_PHASE_SPACE;
+        } else if (s->state == LFS2_EXT_STATE_WORK) {
+            *phase = LFS2_EXT_PHASE_MOVE;
+        } else {
+            *phase = LFS2_EXT_PHASE_ERASE;
+        }
+    }
+    if (percent) {
+        if (s->state == LFS2_EXT_STATE_WORK) {
+            int total = s->w.pair_count + s->w.file_count;
+            int done = s->pair_index + s->file_index;
+            *percent = total ? (uint8_t)((done * 100) / total) : 100;
+        } else if (s->state == LFS2_EXT_STATE_ERASE) {
+            *percent = s->count
+                    ? (uint8_t)(((s->erase_next - s->head) * 100) / s->count)
+                    : 100;
+        } else if (s->state == LFS2_EXT_STATE_DONE) {
+            *percent = 100;
+        } else {
+            *percent = 0;
+        }
+    }
+
+    return (s->state == LFS2_EXT_STATE_DONE) ? 0 : 1;
+}
+
+// Turn a cleared window into a reservation, as lfs2_ext_reserve() does after
+// its search.
+static int lfs2_ext_reserve_mark(lfs2_t *lfs2, lfs2_block_t head,
+        lfs2_block_t count, lfs2_size_t length, lfs2_ext_t *out) {
+    lfs2_size_t size = lfs2_ext_map_size(lfs2);
