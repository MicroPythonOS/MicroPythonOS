diff --git a/extmod/vfs_lfsx.c b/extmod/vfs_lfsx.c
index bbdd21cf..c9320cb0 100644
--- a/extmod/vfs_lfsx.c
+++ b/extmod/vfs_lfsx.c
@@ -99,7 +99,12 @@ static void MP_VFS_LFSx(init_config)(MP_OBJ_VFS_LFSx * self, mp_obj_t bdev, size
     config->lookahead_buffer = m_new(uint8_t, config->lookahead / 8);
