{
  "name": "AppStore",
  "publisher": "MicroPythonOS",
  "short_description": "Store for App(lication)s",
  "long_description": "Find and install apps for your device.",
  "fullname": "com.micropythonos.appstore",
  "version": "1.5.4",
  "categories": [
    "Appstore"
  ],
  "activities": [
    {
      "entrypoint": "appstore.py",
      "classname": "AppStore",
      "intent_filters": [
        {
          "action": "main",
          "category": "launcher"
        },
        {
          "action": "com.micropythonos.appstore.updates",
          "pathPattern": "mpos-appstore://updates"
        }
      ]
    }
  ],
  "services": [
    {
      "entrypoint": "appstore_boot_service.py",
      "classname": "AppStoreService",
      "intent_filters": [
        {
          "action": "boot_completed",
          "delay_s": 120
        }
      ]
    }
  ]
}
